  "paragraphs": [
    {
      "alignment": "center", "lineHeight": 1.2, "spaceBefore": 2, "spaceAfter": 4,
      "runs": [
        { "text": "Árvíz & <x>", "emphasis": ["strong", "emphasis", "underline", "strike", "small-caps"], "presentation": { "fontFamily": "Arial", "fontSize": 12, "color": "#EE0000" } },
        { "text": "\n", "emphasis": [] },
        { "text": "2", "emphasis": ["superscript", "subscript"] }
      ]
    },
    { "alignment": "left", "lineHeight": 1.15, "spaceBefore": 0, "spaceAfter": 0, "runs": [{ "text": "Second paragraph", "emphasis": [] }] }
  ]
}
