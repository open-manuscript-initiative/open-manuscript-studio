{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmanuscript.org/schemas/research-project-0.1.schema.json",
  "title": "OMI-SPEC-360 Draft 0.1.0 project envelope",
  "type": "object",
  "required": [
    "format",
    "version",
    "projectId",
    "title",
    "createdAt",
    "updatedAt",
    "resources"
  ],
  "properties": {
    "format": {
      "const": "omi-research-project"
    },
    "version": {
      "const": "0.1.0"
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "title": {
      "type": "string",
      "maxLength": 1000
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "resource": {
      "type": "object",
      "required": [
        "resourceId",
        "resourceType",
        "schemaVersion",
        "mediaType"
      ],
      "properties": {
        "resourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "resourceType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "schemaVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "mediaType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "inline": true,
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "oneOf": [
        {
          "required": [
            "inline"
          ],
          "properties": {
            "inline": true,
            "path": false
          }
        },
        {
          "required": [
            "path",
            "sizeBytes",
            "sha256"
          ],
          "properties": {
            "path": true,
            "sizeBytes": true,
            "sha256": true,
            "inline": false
          }
        }
      ],
      "additionalProperties": true
    }
  }
}
