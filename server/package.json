{
  "name": "@omi/studio-server",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Backend API for Open Manuscript Studio.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run prisma:generate:all && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "integration:add": "tsx src/cli/addIntegration.ts",
    "review:grant": "tsx src/cli/grantReviewAccess.ts",
    "prisma:generate": "prisma generate",
    "prisma:generate:identity": "prisma generate --config prisma.identity.config.ts",
    "prisma:generate:all": "npm run prisma:generate && npm run prisma:generate:identity",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:identity:dev": "prisma migrate dev --config prisma.identity.config.ts",
    "prisma:migrate:identity:deploy": "prisma migrate deploy --config prisma.identity.config.ts",
    "prisma:studio": "prisma studio",
    "prisma:studio:identity": "prisma studio --config prisma.identity.config.ts",
    "test:jats-validation": "node --import tsx --test ../tests/jats-schema-validation.test.ts"
  },
  "dependencies": {
    "@jats4r/dtds": "0.0.10",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.0.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.0.0",
    "jose": "^6.1.0",
    "libxml2-wasm": "0.7.2",
    "pg": "^8.23.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "prisma": "^7.9.1",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "prisma": {
      "mysql2": "3.23.1"
    },
    "deepmerge-ts": "8.0.2"
  }
}
