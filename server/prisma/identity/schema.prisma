generator client {
  provider = "prisma-client"
  output   = "../../src/generated/identity-prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum IdentityProvider {
  ORCID
  OIDC
  SAML
}

enum PublicationVenueType {
  JOURNAL
  BOOK_PUBLISHER
}

enum PublicationVenueIntegrationProvider {
  OJS
  OMP
}

enum PublicationVenueIntegrationStatus {
  VERIFIED
  DISABLED
}

enum PublicationVenueDomainVerificationStatus {
  PENDING
  VERIFIED
  REVOKED
}

enum PublicationVenueRole {
  DOMAIN_ADMIN
  EDITOR_IN_CHIEF
  EDITOR
}

enum InstitutionStatus {
  ACTIVE
  DISABLED
}

enum InstitutionRole {
  MEMBER
  ADMIN
  OWNER
}

enum CentralAdminRole {
  ADMIN
  OWNER
}

enum InstitutionApiCredentialStatus {
  ACTIVE
  REVOKED
}

model User {
  id                     String                  @id @default(uuid()) @db.Uuid
  email                  String                  @unique @db.VarChar(320)
  omiUserId              String?                 @unique @map("omi_user_id") @db.Uuid
  passwordHash           String                  @map("password_hash") @db.VarChar(255)
  fullName               String                  @map("full_name") @db.VarChar(200)
  affiliation            String?                 @db.VarChar(300)
  affiliationRorId       String?                 @map("affiliation_ror_id") @db.VarChar(128)
  orcid                  String?                 @unique @db.VarChar(19)
  bio                    String?                 @db.VarChar(2000)
  timeZone               String?                 @map("time_zone") @db.VarChar(64)
  interfaceLanguage      String                  @default("en") @map("interface_language") @db.VarChar(16)
  status                 UserStatus              @default(ACTIVE)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLoginAt            DateTime?               @map("last_login_at") @db.Timestamptz(6)
  sessions               UserSession[]
  invitations            UserInvitation[]
  identities             UserIdentity[]
  institutionMemberships InstitutionMembership[]
  centralAdminGrant      CentralAdminGrant?
  oauthStates            OAuthLoginState[]
  passwordResetTokens    PasswordResetToken[]
  publicationVenues      PublicationVenue[]
  publicationVenueDomainVerifications PublicationVenueDomainVerification[] @relation("PublicationVenueDomainVerificationRequester")
  publicationVenueMemberships PublicationVenueMembership[] @relation("PublicationVenueMember")
  publicationVenueMembershipGrants PublicationVenueMembership[] @relation("PublicationVenueMembershipGrantor")
  profileEmails          UserProfileEmail[]
  publishingCredentials  PersonalPublishingCredential[]

  @@map("users")
}

model UserSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, usedAt])
  @@map("password_reset_tokens")
}

model UserInvitation {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, usedAt])
  @@map("user_invitations")
}

model UserIdentity {
  id                     String                  @id @default(uuid()) @db.Uuid
  userId                 String                  @map("user_id") @db.Uuid
  provider               IdentityProvider
  issuer                 String                  @db.VarChar(512)
  subject                String                  @db.VarChar(320)
  displayName            String?                 @map("display_name") @db.VarChar(200)
  profile                Json?                   @db.JsonB
  accessToken            String?                 @map("access_token") @db.Text
  refreshToken           String?                 @map("refresh_token") @db.Text
  tokenExpiresAt         DateTime?               @map("token_expires_at") @db.Timestamptz(6)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastUsedAt             DateTime?               @map("last_used_at") @db.Timestamptz(6)
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionMemberships InstitutionMembership[]

  @@unique([provider, issuer, subject])
  @@index([userId, provider])
  @@map("user_identities")
}

model UserProfileEmail {
  id                    String                         @id @default(uuid()) @db.Uuid
  userId                String                         @map("user_id") @db.Uuid
  email                 String                         @db.VarChar(320)
  isPrimary             Boolean                        @default(false) @map("is_primary")
  createdAt             DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                  User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishingCredentials PersonalPublishingCredential[]

  @@unique([userId, email])
  @@index([userId, isPrimary])
  @@map("user_profile_emails")
}

model PersonalPublishingCredential {
  id               String                              @id @default(uuid()) @db.Uuid
  userId           String                              @map("user_id") @db.Uuid
  profileEmailId   String                              @map("profile_email_id") @db.Uuid
  provider         PublicationVenueIntegrationProvider
  label            String?                             @db.VarChar(200)
  baseUrl          String                              @map("base_url") @db.VarChar(2048)
  apiKeyCiphertext String                              @map("api_key_ciphertext") @db.Text
  apiKeyIv         String                              @map("api_key_iv") @db.VarChar(64)
  apiKeyAuthTag    String                              @map("api_key_auth_tag") @db.VarChar(64)
  createdAt        DateTime                            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                            @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User                                @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileEmail     UserProfileEmail                    @relation(fields: [profileEmailId], references: [id], onDelete: Restrict)

  @@unique([userId, provider, baseUrl, profileEmailId])
  @@index([userId, provider, baseUrl])
  @@index([profileEmailId])
  @@map("personal_publishing_credentials")
}

model PublicationVenue {
  id                        String                              @id @default(uuid()) @db.Uuid
  type                      PublicationVenueType
  name                      String                              @db.VarChar(300)
  normalizedName            String                              @map("normalized_name") @db.VarChar(300)
  website                   String?                             @db.VarChar(2048)
  issn                      String?                             @db.VarChar(32)
  isbnPrefix                String?                             @map("isbn_prefix") @db.VarChar(64)
  integrationProvider       PublicationVenueIntegrationProvider? @map("integration_provider")
  integrationStatus         PublicationVenueIntegrationStatus    @default(DISABLED) @map("integration_status")
  integrationInstallationId String?                             @map("integration_installation_id") @db.VarChar(128)
  integrationBaseUrl        String?                             @map("integration_base_url") @db.VarChar(2048)
  integrationVerifiedAt     DateTime?                           @map("integration_verified_at") @db.Timestamptz(6)
  createdByUserId           String?                             @map("created_by_user_id") @db.Uuid
  createdAt                 DateTime                            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                            @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy                 User?                               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  domainVerifications        PublicationVenueDomainVerification[]
  memberships               PublicationVenueMembership[]

  @@unique([type, normalizedName])
  @@index([type, normalizedName])
  @@index([type, integrationStatus])
  @@index([integrationInstallationId])
  @@map("publication_venues")
}

model PublicationVenueDomainVerification {
  id                String                                   @id @default(uuid()) @db.Uuid
  venueId           String                                   @map("venue_id") @db.Uuid
  domain            String                                   @db.VarChar(253)
  txtRecordName     String                                   @map("txt_record_name") @db.VarChar(300)
  tokenHash         String                                   @map("token_hash") @db.VarChar(64)
  status            PublicationVenueDomainVerificationStatus @default(PENDING)
  requestedByUserId String                                   @map("requested_by_user_id") @db.Uuid
  expiresAt         DateTime                                 @map("expires_at") @db.Timestamptz(6)
  verifiedAt        DateTime?                                @map("verified_at") @db.Timestamptz(6)
  lastCheckedAt     DateTime?                                @map("last_checked_at") @db.Timestamptz(6)
  createdAt         DateTime                                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  venue             PublicationVenue                         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  requestedBy       User                                     @relation("PublicationVenueDomainVerificationRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)

  @@unique([venueId, domain])
  @@index([domain, status])
  @@index([requestedByUserId, status])
  @@map("publication_venue_domain_verifications")
}

model PublicationVenueMembership {
  id              String               @id @default(uuid()) @db.Uuid
  venueId         String               @map("venue_id") @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  role            PublicationVenueRole
  active          Boolean              @default(true)
  grantedByUserId String               @map("granted_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  venue           PublicationVenue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user            User                 @relation("PublicationVenueMember", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy       User                 @relation("PublicationVenueMembershipGrantor", fields: [grantedByUserId], references: [id], onDelete: Restrict)

  @@unique([venueId, userId, role])
  @@index([venueId, role, active])
  @@index([userId, active])
  @@map("publication_venue_memberships")
}

model Institution {
  id             String                     @id @default(uuid()) @db.Uuid
  name           String                     @db.VarChar(300)
  rorId          String?                    @unique @map("ror_id") @db.VarChar(128)
  status         InstitutionStatus          @default(ACTIVE)
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships    InstitutionMembership[]
  apiCredentials InstitutionApiCredential[]

  @@index([name])
  @@map("institutions")
}

model InstitutionMembership {
  id                 String          @id @default(uuid()) @db.Uuid
  userId             String          @map("user_id") @db.Uuid
  institutionId      String          @map("institution_id") @db.Uuid
  role               InstitutionRole @default(MEMBER)
  department         String?         @db.VarChar(300)
  positionTitle      String?         @map("position_title") @db.VarChar(200)
  institutionalEmail String?         @map("institutional_email") @db.VarChar(320)
  emailVerified      Boolean         @default(false) @map("email_verified")
  identityId         String?         @map("identity_id") @db.Uuid
  isDefault          Boolean         @default(false) @map("is_default")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution        Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  identity           UserIdentity?   @relation(fields: [identityId], references: [id], onDelete: SetNull)

  @@unique([userId, institutionId])
  @@index([userId, isDefault])
  @@index([institutionId, role])
  @@index([identityId])
  @@map("institution_memberships")
}

model CentralAdminGrant {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @unique @map("user_id") @db.Uuid
  role            CentralAdminRole @default(ADMIN)
  createdByUserId String?          @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([role])
  @@map("central_admin_grants")
}

model InstitutionApiCredential {
  id              String                         @id @default(uuid()) @db.Uuid
  institutionId   String                         @map("institution_id") @db.Uuid
  label           String                         @db.VarChar(160)
  tokenPrefix     String                         @map("token_prefix") @db.VarChar(24)
  tokenHash       String                         @unique @map("token_hash") @db.VarChar(64)
  scopes          String[]
  status          InstitutionApiCredentialStatus @default(ACTIVE)
  expiresAt       DateTime?                      @map("expires_at") @db.Timestamptz(6)
  lastUsedAt      DateTime?                      @map("last_used_at") @db.Timestamptz(6)
  createdByUserId String                         @map("created_by_user_id") @db.Uuid
  createdAt       DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt       DateTime?                      @map("revoked_at") @db.Timestamptz(6)
  institution     Institution                    @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId, status])
  @@index([expiresAt])
  @@map("institution_api_credentials")
}

model AdminAuditEvent {
  id              String   @id @default(uuid()) @db.Uuid
  actorUserId     String?  @map("actor_user_id") @db.Uuid
  apiCredentialId String?  @map("api_credential_id") @db.Uuid
  institutionId   String?  @map("institution_id") @db.Uuid
  action          String   @db.VarChar(120)
  targetType      String?  @map("target_type") @db.VarChar(80)
  targetId        String?  @map("target_id") @db.VarChar(160)
  details         Json?    @db.JsonB
  ipAddress       String?  @map("ip_address") @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([institutionId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("admin_audit_events")
}

model OAuthLoginState {
  id              String           @id @default(uuid()) @db.Uuid
  stateHash       String           @unique @map("state_hash") @db.VarChar(64)
  provider        IdentityProvider
  mode            String           @db.VarChar(32)
  userId          String?          @map("user_id") @db.Uuid
  invitationToken String?          @map("invitation_token") @db.Text
  returnPath      String?          @map("return_path") @db.VarChar(2048)
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("oauth_login_states")
}
