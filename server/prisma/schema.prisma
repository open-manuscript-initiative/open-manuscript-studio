generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ExternalPlatform {
  OJS
  OMP
}

enum ExternalInstallationStatus {
  ACTIVE
  DISABLED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(320)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  fullName     String     @map("full_name") @db.VarChar(200)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(6)

  @@map("users")
}

model ExternalInstallation {
  id                     String                     @id @default(uuid()) @db.Uuid
  installationId         String                     @unique @map("installation_id") @db.VarChar(128)
  platform               ExternalPlatform
  displayName            String                     @map("display_name") @db.VarChar(200)
  baseUrl                String                     @map("base_url") @db.VarChar(2048)
  sharedSecretCiphertext String                     @map("shared_secret_ciphertext") @db.Text
  sharedSecretIv         String                     @map("shared_secret_iv") @db.VarChar(128)
  sharedSecretAuthTag    String                     @map("shared_secret_auth_tag") @db.VarChar(128)
  status                 ExternalInstallationStatus @default(ACTIVE)
  createdAt              DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([platform, status])
  @@map("external_installations")
}

model ExternalLaunchNonce {
  id             String   @id @default(uuid()) @db.Uuid
  installationId String   @map("installation_id") @db.VarChar(128)
  nonce          String   @db.VarChar(256)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([installationId, nonce])
  @@index([expiresAt])
  @@map("external_launch_nonces")
}
