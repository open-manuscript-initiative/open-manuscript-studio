generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum IdentityProvider {
  ORCID
  OIDC
  SAML
}

enum ExternalPlatform {
  OJS
  OMP
}

enum ExternalInstallationStatus {
  ACTIVE
  DISABLED
}

enum ReviewStatus {
  INVITED
  ACCEPTED
  DECLINED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
}

enum ReviewRecommendation {
  ACCEPT
  MINOR_REVISION
  MAJOR_REVISION
  REJECT
}

enum ReviewAssignmentType {
  SCIENTIFIC_REVIEW
  LANGUAGE_REVIEW
  TRANSLATION
  EDITORIAL_REVISION
}

enum ReviewAnonymityMode {
  DOUBLE_BLIND
  SINGLE_BLIND
  OPEN
}

enum ReviewFeedbackVisibility {
  AUTHOR_AND_EDITOR
  EDITOR_ONLY
}

enum ReviewWorkspaceRole {
  AUTHOR
  EDITOR
}

enum CloudProviderType {
  WEBDAV
  NEXTCLOUD
}

enum CloudConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum CloudBackupStatus {
  COMPLETED
  FAILED
}

model User {
  id                        String                  @id @default(uuid()) @db.Uuid
  email                     String                  @unique @db.VarChar(320)
  passwordHash              String                  @map("password_hash") @db.VarChar(255)
  fullName                  String                  @map("full_name") @db.VarChar(200)
  affiliation               String?                 @db.VarChar(300)
  affiliationRorId          String?                 @map("affiliation_ror_id") @db.VarChar(128)
  orcid                     String?                 @unique @db.VarChar(19)
  interfaceLanguage         String                  @default("en") @map("interface_language") @db.VarChar(16)
  status                    UserStatus              @default(ACTIVE)
  createdAt                 DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLoginAt               DateTime?               @map("last_login_at") @db.Timestamptz(6)
  sessions                  UserSession[]
  invitations               UserInvitation[]
  identities                UserIdentity[]
  oauthStates               OAuthLoginState[]
  reviewAssignments         PeerReviewAssignment[]  @relation("ReviewerAssignments")
  assignedReviewAssignments PeerReviewAssignment[]  @relation("ReviewAssigner")
  reviewWorkspaceAccess     ReviewWorkspaceAccess[]
  cloudConnections          CloudConnection[]
  cloudBackups              CloudBackup[]
  integrations              UserIntegration[]

  @@map("users")
}

model UserSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model UserInvitation {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, usedAt])
  @@map("user_invitations")
}

model UserIdentity {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  provider       IdentityProvider
  issuer         String           @db.VarChar(512)
  subject        String           @db.VarChar(320)
  displayName    String?          @map("display_name") @db.VarChar(200)
  profile        Json?            @db.JsonB
  accessToken    String?          @map("access_token") @db.Text
  refreshToken   String?          @map("refresh_token") @db.Text
  tokenExpiresAt DateTime?        @map("token_expires_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastUsedAt     DateTime?        @map("last_used_at") @db.Timestamptz(6)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, issuer, subject])
  @@index([userId, provider])
  @@map("user_identities")
}

model OAuthLoginState {
  id              String           @id @default(uuid()) @db.Uuid
  stateHash       String           @unique @map("state_hash") @db.VarChar(64)
  provider        IdentityProvider
  mode            String           @db.VarChar(16)
  userId          String?          @map("user_id") @db.Uuid
  invitationToken String?          @map("invitation_token") @db.Text
  returnPath      String?          @map("return_path") @db.VarChar(1024)
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("oauth_login_states")
}

model ReviewWorkspaceAccess {
  id           String              @id @default(uuid()) @db.Uuid
  workspaceId  String              @map("workspace_id") @db.VarChar(128)
  manuscriptId String              @map("manuscript_id") @db.VarChar(128)
  userId       String              @map("user_id") @db.Uuid
  role         ReviewWorkspaceRole
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, role])
  @@index([userId, role])
  @@index([workspaceId, role])
  @@map("review_workspace_access")
}

model PeerReviewAssignment {
  id                       String                @id @default(uuid()) @db.Uuid
  workspaceId              String                @map("workspace_id") @db.VarChar(128)
  manuscriptId             String                @map("manuscript_id") @db.VarChar(128)
  reviewerUserId           String                @map("reviewer_user_id") @db.Uuid
  assignedByUserId         String?               @map("assigned_by_user_id") @db.Uuid
  externalInstallationId   String?               @map("external_installation_id") @db.VarChar(128)
  externalAssignmentId     String?               @map("external_assignment_id") @db.VarChar(128)
  reviewerAlias            String                @map("reviewer_alias") @db.VarChar(64)
  assignmentType           ReviewAssignmentType  @default(SCIENTIFIC_REVIEW) @map("assignment_type")
  sourceLanguage           String?               @map("source_language") @db.VarChar(32)
  targetLanguage           String?               @map("target_language") @db.VarChar(32)
  reviewRound              Int                   @default(1) @map("review_round")
  anonymityMode            ReviewAnonymityMode   @default(DOUBLE_BLIND) @map("anonymity_mode")
  status                   ReviewStatus          @default(INVITED)
  recommendation           ReviewRecommendation?
  manuscriptSnapshot       Json?                 @map("manuscript_snapshot") @db.JsonB
  reviewRevisionSnapshot   Json?                 @map("review_revision_snapshot") @db.JsonB
  revisionUpdatedAt        DateTime?             @map("revision_updated_at") @db.Timestamptz(6)
  invitedAt                DateTime              @default(now()) @map("invited_at") @db.Timestamptz(6)
  acceptedAt               DateTime?             @map("accepted_at") @db.Timestamptz(6)
  submittedAt              DateTime?             @map("submitted_at") @db.Timestamptz(6)
  completedAt              DateTime?             @map("completed_at") @db.Timestamptz(6)
  createdAt                DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  reviewer                 User                  @relation("ReviewerAssignments", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  assignedBy               User?                 @relation("ReviewAssigner", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  feedback                 PeerReviewFeedback[]

  @@unique([workspaceId, reviewerUserId, reviewRound, assignmentType])
  @@unique([externalInstallationId, externalAssignmentId])
  @@index([workspaceId, status])
  @@index([workspaceId, assignmentType, status])
  @@index([manuscriptId])
  @@index([reviewerUserId, status])
  @@map("peer_review_assignments")
}

model PeerReviewFeedback {
  id           String                   @id @default(uuid()) @db.Uuid
  assignmentId String                   @map("assignment_id") @db.Uuid
  visibility   ReviewFeedbackVisibility
  body         String                   @db.Text
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignment   PeerReviewAssignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, visibility])
  @@map("peer_review_feedback")
}

model IntegrationProviderConfig {
  id                 String    @id @default(uuid()) @db.Uuid
  providerId         String    @unique @map("provider_id") @db.VarChar(128)
  enabled            Boolean   @default(true)
  authenticationMode String?   @map("authentication_mode") @db.VarChar(32)
  config              Json?     @db.JsonB
  encryptedSecret     String?   @map("encrypted_secret") @db.Text
  status              String    @default("UNCONFIGURED") @db.VarChar(32)
  lastCheckedAt       DateTime? @map("last_checked_at") @db.Timestamptz(6)
  lastError           String?   @map("last_error") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([enabled, status])
  @@map("integration_provider_configs")
}

model UserIntegration {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  providerId         String    @map("provider_id") @db.VarChar(128)
  connectionKey      String    @default("default") @map("connection_key") @db.VarChar(128)
  displayName        String?   @map("display_name") @db.VarChar(200)
  authenticationMode String    @map("authentication_mode") @db.VarChar(32)
  enabled            Boolean   @default(true)
  config              Json?     @db.JsonB
  encryptedSecret     String?   @map("encrypted_secret") @db.Text
  status              String    @default("CONFIGURED") @db.VarChar(32)
  lastCheckedAt       DateTime? @map("last_checked_at") @db.Timestamptz(6)
  lastError           String?   @map("last_error") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId, connectionKey])
  @@index([userId, providerId])
  @@index([providerId, enabled, status])
  @@map("user_integrations")
}

model ExternalInstallation {
  id                     String                     @id @default(uuid()) @db.Uuid
  installationId         String                     @unique @map("installation_id") @db.VarChar(128)
  platform               ExternalPlatform
  displayName            String                     @map("display_name") @db.VarChar(200)
  baseUrl                String                     @map("base_url") @db.VarChar(2048)
  sharedSecretCiphertext String                     @map("shared_secret_ciphertext") @db.Text
  sharedSecretIv         String                     @map("shared_secret_iv") @db.VarChar(128)
  sharedSecretAuthTag    String                     @map("shared_secret_auth_tag") @db.VarChar(128)
  status                 ExternalInstallationStatus @default(ACTIVE)
  createdAt              DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([platform, status])
  @@map("external_installations")
}

model ExternalLaunchNonce {
  id             String   @id @default(uuid()) @db.Uuid
  installationId String   @map("installation_id") @db.VarChar(128)
  nonce          String   @db.VarChar(256)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([installationId, nonce])
  @@index([expiresAt])
  @@map("external_launch_nonces")
}

model CloudConnection {
  id                   String                @id @default(uuid()) @db.Uuid
  userId               String                @map("user_id") @db.Uuid
  providerType         CloudProviderType     @map("provider_type")
  displayName          String                @map("display_name") @db.VarChar(200)
  status               CloudConnectionStatus @default(DISCONNECTED)
  encryptedCredentials String                @map("encrypted_credentials") @db.Text
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastVerifiedAt       DateTime?             @map("last_verified_at") @db.Timestamptz(6)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  backups              CloudBackup[]

  @@index([userId])
  @@index([providerType, status])
  @@map("cloud_connections")
}

model CloudBackup {
  id               String            @id @default(uuid()) @db.Uuid
  manuscriptId     String            @map("manuscript_id") @db.VarChar(128)
  userId           String            @map("user_id") @db.Uuid
  connectionId     String            @map("connection_id") @db.Uuid
  providerObjectId String            @map("provider_object_id") @db.Text
  providerPath     String            @map("provider_path") @db.Text
  packageVersion   String            @map("package_version") @db.VarChar(32)
  checksum         String            @db.VarChar(64)
  sizeBytes        BigInt            @map("size_bytes")
  status           CloudBackupStatus @default(COMPLETED)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection       CloudConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([manuscriptId, userId, createdAt])
  @@index([connectionId])
  @@map("cloud_backups")
}