NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://ADATBAZIS_FELHASZNALO:JELSZO@127.0.0.1:5432/ADATBAZIS_NEVE?schema=public

FRONTEND_ORIGIN=http://localhost:5173

# 32 random bytes encoded as 64 hexadecimal characters.
# Generate with: openssl rand -hex 32
# This key encrypts OJS/OMP shared secrets at rest and MUST remain server-side.
INTEGRATION_MASTER_KEY=

# ORCID OAuth 2.0 (3-legged OAuth) authentication.
# Use https://sandbox.orcid.org while testing and https://orcid.org in production.
# The client secret MUST remain server-side and must never be exposed through Vite.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_BASE_URL=https://sandbox.orcid.org
# Register this exact callback URL in the ORCID client configuration.
# Production example: https://openmanuscript.org/api/auth/orcid/callback
ORCID_REDIRECT_URI=http://localhost:5173/api/auth/orcid/callback
