NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://ADATBAZIS_FELHASZNALO:JELSZO@127.0.0.1:5432/ADATBAZIS_NEVE?schema=public

FRONTEND_ORIGIN=http://localhost:5173

# Studio installation profile.
# personal: standalone author/user installation
# institutional: publisher, journal, university or service-managed installation
DEPLOYMENT_MODE=personal

# 32 random bytes encoded as 64 hexadecimal characters.
# Generate with: openssl rand -hex 32
# This key encrypts OJS/OMP shared secrets at rest and MUST remain server-side.
INTEGRATION_MASTER_KEY=

# Local mail delivery. Password-reset and assignment-invitation messages use
# this sender and the system sendmail-compatible binary.
MAIL_FROM=Open Manuscript Studio <no-reply@openmanuscript.org>
SENDMAIL_PATH=/usr/sbin/sendmail
INVITATION_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=60

# ORCID network. Sandbox remains the safe default until production credentials
# have been approved and installed.
ORCID_ENVIRONMENT=sandbox

# Personal mode ORCID client. These values are ignored when
# DEPLOYMENT_MODE=institutional.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=http://localhost:5173/api/auth/orcid/callback

# Institutional mode ORCID client. These values are ignored when
# DEPLOYMENT_MODE=personal. The organization owns and manages this client.
INSTITUTIONAL_ORCID_CLIENT_ID=
INSTITUTIONAL_ORCID_CLIENT_SECRET=
INSTITUTIONAL_ORCID_REDIRECT_URI=https://example.org/api/auth/orcid/callback
# public or member
INSTITUTIONAL_ORCID_API_TYPE=public

# Deprecated compatibility option. New deployments should omit it and use
# ORCID_ENVIRONMENT. If both are set, they must point to the same network.
# ORCID_BASE_URL=https://sandbox.orcid.org
