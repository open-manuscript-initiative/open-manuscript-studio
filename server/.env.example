NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://ADATBAZIS_FELHASZNALO:JELSZO@127.0.0.1:5432/ADATBAZIS_NEVE?schema=public

FRONTEND_ORIGIN=http://localhost:5173

# Studio installation profile.
# personal: standalone author/user installation
# institutional: publisher, journal, university or service-managed installation
DEPLOYMENT_MODE=personal

# Managed institutional deployment metadata. INSTITUTIONAL_ADMIN_EMAILS is a
# comma-separated bootstrap allow-list. A listed account receives OWNER access
# only after an OIDC/SAML identity is linked; a password-only account is never
# promoted automatically.
INSTITUTIONAL_NAME=
INSTITUTIONAL_ROR_ID=
INSTITUTIONAL_ADMIN_EMAILS=

# OMI central administration bootstrap. These accounts become central OWNERs
# only after an OIDC/SAML identity is linked. Central administration is a
# separate privilege plane from institution ADMIN/OWNER membership.
CENTRAL_ADMIN_EMAILS=
# Default lifetime for newly issued institution Admin API tokens.
INSTITUTION_API_TOKEN_TTL_DAYS=365

# 32 random bytes encoded as 64 hexadecimal characters.
# Generate with: openssl rand -hex 32
# This key encrypts OJS/OMP and cloud OAuth secrets at rest and MUST remain server-side.
INTEGRATION_MASTER_KEY=

# Local mail delivery. Password-reset and assignment-invitation messages use
# this sender and the system sendmail-compatible binary.
MAIL_FROM=Open Manuscript Studio <no-reply@openmanuscript.org>
SENDMAIL_PATH=/usr/sbin/sendmail
INVITATION_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=60

# ORCID network. Sandbox remains the safe default until production credentials
# have been approved and installed.
ORCID_ENVIRONMENT=sandbox

# Personal mode ORCID client. These values are ignored when
# DEPLOYMENT_MODE=institutional.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=http://localhost:5173/api/auth/orcid/callback

# Institutional mode ORCID client. These values are ignored when
# DEPLOYMENT_MODE=personal. The organization owns and manages this client.
INSTITUTIONAL_ORCID_CLIENT_ID=
INSTITUTIONAL_ORCID_CLIENT_SECRET=
INSTITUTIONAL_ORCID_REDIRECT_URI=https://example.org/api/auth/orcid/callback
# public or member
INSTITUTIONAL_ORCID_API_TYPE=public

# Deprecated compatibility option. New deployments should omit it and use
# ORCID_ENVIRONMENT. If both are set, they must point to the same network.
# ORCID_BASE_URL=https://sandbox.orcid.org

# Optional Google OpenID Connect login.
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=https://studio.example.org/api/auth/oidc/google/callback

# Optional Microsoft identity platform login. Use common for personal + work
# accounts, organizations for work/school accounts, consumers for personal
# Microsoft accounts, or a tenant ID/domain for a single-tenant deployment.
MICROSOFT_OIDC_CLIENT_ID=
MICROSOFT_OIDC_CLIENT_SECRET=
MICROSOFT_OIDC_REDIRECT_URI=https://studio.example.org/api/auth/oidc/microsoft/callback
MICROSOFT_OIDC_TENANT=common

# Optional generic/institutional OpenID Connect provider.
OIDC_ISSUER=https://idp.example.edu
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://studio.example.org/api/auth/oidc/oidc/callback
OIDC_LABEL=Institutional sign-in

# Direct cloud-storage OAuth 2.0 clients. Keep these separate from OIDC login
# clients because they request storage permissions. Each callback URI must be
# registered exactly at the provider.
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=https://studio.example.org/api/cloud/oauth/google-drive/callback

MICROSOFT_STORAGE_OAUTH_CLIENT_ID=
MICROSOFT_STORAGE_OAUTH_CLIENT_SECRET=
MICROSOFT_STORAGE_OAUTH_REDIRECT_URI=https://studio.example.org/api/cloud/oauth/onedrive/callback
# common = personal + work/school, organizations = work/school only,
# consumers = personal Microsoft accounts only, or use a tenant ID/domain.
MICROSOFT_STORAGE_OAUTH_TENANT=common

DROPBOX_OAUTH_CLIENT_ID=
DROPBOX_OAUTH_CLIENT_SECRET=
DROPBOX_OAUTH_REDIRECT_URI=https://studio.example.org/api/cloud/oauth/dropbox/callback
