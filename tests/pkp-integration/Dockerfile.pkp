ARG PKP_PLATFORM=ojs
ARG PKP_VERSION=3_5_0-4
FROM docker.io/pkpofficial/${PKP_PLATFORM}:${PKP_VERSION}

USER root

COPY --chown=www-data:www-data runtime/plugin/ /var/www/html/plugins/generic/studioIntegration/
COPY --chown=www-data:www-data pkp/omiIntegrationFixture.php /var/www/html/tools/omiIntegrationFixture.php

RUN test -f /var/www/html/plugins/generic/studioIntegration/version.xml \
    && test -f /var/www/html/plugins/generic/studioIntegration/StudioIntegrationPlugin.php \
    && test -f /var/www/html/tools/omiIntegrationFixture.php

# PHP in the PKP Apache image does not reliably expose Authorization to the
# application. Preserve the signed OMI header for the integration API.
RUN printf '%s\n' \
      'SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1' \
      > /etc/apache2/conf-enabled/omi-authorization.conf

USER www-data
