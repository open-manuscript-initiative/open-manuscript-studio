# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://omi_user:change-me@127.0.0.1:5432/omi_studio?schema=public"

# 32 random bytes encoded as 64 hexadecimal characters.
# Generate with: openssl rand -hex 32
# This encrypts external integration secrets at rest and MUST stay server-side.
INTEGRATION_MASTER_KEY=""

# Studio integration backend port
SERVER_PORT=3001

# Example only: external OJS/OMP shared secrets are NOT stored here.
# Register each installation with `npm run integration:add` after migration.
