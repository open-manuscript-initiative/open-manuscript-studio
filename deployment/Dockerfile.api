FROM node:24-bookworm-slim AS build
WORKDIR /opt/omi-studio/server

COPY server/package.json server/package-lock.json ./
RUN npm ci

COPY server/ ./
ARG DATABASE_URL=postgresql://omi_build:omi_build@127.0.0.1:5432/omi_studio
ARG IDENTITY_DATABASE_URL=postgresql://omi_build:omi_build@127.0.0.1:5432/omi_identity
ENV DATABASE_URL=${DATABASE_URL}
ENV IDENTITY_DATABASE_URL=${IDENTITY_DATABASE_URL}
RUN npm run build

FROM node:24-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /opt/omi-studio/server

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates chromium msmtp-mta fonts-liberation fonts-noto-core \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global @vivliostyle/cli@11.0.4

COPY --from=build --chown=node:node /opt/omi-studio/server/package.json ./package.json
COPY --from=build --chown=node:node /opt/omi-studio/server/package-lock.json ./package-lock.json
COPY --from=build --chown=node:node /opt/omi-studio/server/node_modules ./node_modules
COPY --from=build --chown=node:node /opt/omi-studio/server/dist ./dist
COPY --from=build --chown=node:node /opt/omi-studio/server/src/generated ./src/generated
COPY --from=build --chown=node:node /opt/omi-studio/server/prisma ./prisma
COPY --from=build --chown=node:node /opt/omi-studio/server/prisma.config.ts ./prisma.config.ts
COPY --from=build --chown=node:node /opt/omi-studio/server/prisma.identity.config.ts ./prisma.identity.config.ts

ENV PORT=3001
ENV COLLABORATION_WS_PORT=3022
ENV VIVLIOSTYLE_BIN=/usr/local/bin/vivliostyle
ENV VIVLIOSTYLE_EXECUTABLE_BROWSER=/usr/bin/chromium
EXPOSE 3001 3022
USER node
CMD ["sh", "-c", "npm run prisma:migrate:deploy && npm run prisma:migrate:identity:deploy && npm run start"]
