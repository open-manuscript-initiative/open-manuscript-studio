# Public URL that users open in their browser. Include the scheme, no trailing slash.
PUBLIC_ORIGIN=https://studio.example.org

# install.sh replaces these placeholders with cryptographically random values.
POSTGRES_PASSWORD=GENERATE_ON_INSTALL
INTEGRATION_MASTER_KEY=GENERATE_ON_INSTALL

# Keep the web container bound to localhost when using an existing reverse proxy.
# Set to 0.0.0.0 only when exposing HTTP directly on a trusted network.
STUDIO_BIND_ADDRESS=127.0.0.1
STUDIO_HTTP_PORT=8080
DEPLOYMENT_MODE=personal
# The beta channel moves with main. For reproducible installs use sha-<40-character commit>.
# A 1.0 release must use its separately gated version/digest, never beta.
STUDIO_IMAGE_TAG=beta
MANUSCRIPT_COLLABORATION_ENABLED=true

# Optional sender address for password-reset and invitation e-mails.
MAIL_FROM=Open Manuscript Studio <no-reply@example.org>
