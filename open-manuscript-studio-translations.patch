+    {"key":"/supplemental/help/topics[23].body","source":"Studio can create a music-score block from MusicXML (.musicxml, .xml) and MIDI (.mid, .midi) files. MusicXML import reads structured notation data including the title, available creator/composer information, time signature, pitch, accidentals, octave, duration, note type, and rests. MIDI import primarily transfers pitch-based note events, so it does not preserve the full semantics or typography of the original score.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":["XML"],"translation":""},
+    {"key":"/supplemental/help/topics[23].tips[0]","source":"Use MusicXML whenever possible for editable, structured notation; MIDI is better suited to transferring pitch data.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":["XML"],"translation":""},
