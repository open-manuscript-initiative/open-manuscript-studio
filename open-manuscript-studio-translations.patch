+    {"key":"/supplemental/help/topics[9].body","source":"When importing a Word document, Studio attempts to convert headings, supported inline formatting, notes, tables and other recognizable structures into semantic OMI elements.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":["OMI"],"translation":""},
+    {"key":"/supplemental/help/topics[9].tips[0]","source":"Use Word Heading 1, Heading 2, etc. for section headings.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
