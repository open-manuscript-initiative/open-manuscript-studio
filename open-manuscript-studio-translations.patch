+    {"key":"/supplemental/help/description","source":"Guide to the manuscript, peer-review, publication and export features currently available in Studio 0.1.0-alpha.1.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/gettingStarted","source":"Studio edits a semantic manuscript: headings, sections, notes, citations, figures, tables, equations and metadata are retained as structured objects rather than presentation alone. When a manuscript is opened from OJS, Studio imports the document and available publication data through the integration.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/navigation","source":"Help","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/title","source":"Open Manuscript Studio Help","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":["Open Manuscript Studio"],"translation":""},
+    {"key":"/supplemental/help/topics[0].body","source":"Edit manuscript text and structure in the main editor. Studio preserves the meaning of paragraphs, headings and supported inline formatting so the structure can be carried into other output formats.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[0].tips[0]","source":"Use real heading levels for section headings.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[0].tips[1]","source":"Do not express document structure with bold, italics or font size alone.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[0].tips[2]","source":"Prefer semantic elements to direct presentation formatting.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[0].title","source":"1. Manuscript editing and semantic formatting","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[1].body","source":"Document sections form a hierarchy. Studio manages section levels and publication-profile numbering so the chapter structure can be retained during export.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[1].tips[0]","source":"Use heading levels consistently and place subsections under the correct parent section.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[1].tips[1]","source":"Prefer profile-driven numbering to manually typed section numbers.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[1].title","source":"2. Sections, hierarchy and numbering","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[10].body","source":"In an OJS-launched session, Studio can import the manuscript and available publication metadata according to the integration scopes granted for that context. Data transfer between Studio and OJS is tied to the relevant assignment and permissions.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[10].tips[0]","source":"Only data actually stored in OJS can be imported.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[10].tips[1]","source":"If metadata is missing, first check OJS Publication metadata and the relevant locale.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[10].tips[2]","source":"Make sure the document was opened with the intended role and assignment.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[10].title","source":"11. OJS integration","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[11].body","source":"Studio separates the manuscript, peer-review assignment and reviewer work in its review model. With OJS integration, reviewer access is tied to the assignment so the reviewer receives the content and operations permitted for that review context.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[11].tips[0]","source":"For review work, use the Studio session launched from the relevant assignment.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[11].tips[1]","source":"In double-blind review, avoid adding information that unnecessarily reveals author or reviewer identity.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[11].title","source":"12. Peer review","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[12].body","source":"Studio tracks manuscript state changes as revisions. Revision state can carry an integrity digest, while deleted structural objects can remain traceable through tombstone data. This supports auditability and portable state verification.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[12].tips[0]","source":"Create a clear revision checkpoint before major structural changes.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[12].tips[1]","source":"Before export, verify that the current manuscript state is the revision you intend to publish.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[12].title","source":"13. Revisions, history and integrity","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[13].body","source":"A publication profile separates manuscript content from publisher presentation and policy. Profiles can define page size, margins, typography, section and object numbering, note placement, caption positions, metadata requirements and supported outputs.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[13].tips[0]","source":"Do not reshape manuscript content merely to imitate publisher layout; put presentation rules in the profile.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[13].tips[1]","source":"Review publication-readiness errors and warnings before export.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[13].title","source":"14. Publication profiles","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[14].body","source":"Alongside built-in profiles, a custom publisher profile version can be created and applied. A profile version records publisher rules; read-only profiles should be changed by creating a new version instead of editing them in place.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[14].tips[0]","source":"Create a new profile version for significant publisher-rule changes.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[14].tips[1]","source":"Profiles can be exported and reused in another installation.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[14].title","source":"15. Custom publisher profiles and protection","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[15].body","source":"A custom publisher profile can carry general publication Export CSS and a separate Print/PDF CSS layer. General CSS controls publication HTML presentation; the print layer is applied afterwards and can add @page, margin, page-break and other print rules for PDF output.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":["HTML"],"translation":""},
+    {"key":"/supplemental/help/topics[15].tips[0]","source":"These styles affect publication output, not the Studio editing interface.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[15].tips[1]","source":"Print/PDF CSS is applied after general export styling and can therefore override it.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[15].tips[2]","source":"Advanced paged-media headers and footers also depend on the PDF or browser engine being used.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[15].title","source":"16. Export CSS and Print/PDF CSS","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[16].body","source":"Export & tools provides several outputs from the same semantic manuscript and active publication profile. Current formats include portable OMI and OMI JSON, JATS XML, semantic HTML, DOCX, IDML, XTG, MIF, SLA, LaTeX, EPUB and a print-to-PDF workflow.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":["OMI","JATS","JATS XML","DOCX","JSON","XML","HTML","LaTeX","TeX","EPUB","IDML","MIF","SLA"],"translation":""},
+    {"key":"/supplemental/help/topics[16].tips[0]","source":"Prefer portable OMI for archival or further OMI processing.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":["OMI"],"translation":""},
+    {"key":"/supplemental/help/topics[16].tips[1]","source":"Use JATS for journal XML workflows.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":["JATS","XML"],"translation":""},
+    {"key":"/supplemental/help/topics[16].tips[2]","source":"PDF is currently saved through the browser print view.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[16].title","source":"17. Export formats","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[17].body","source":"Semantic HTML export produces a script-free publication document. Before export, Studio validates the manuscript against the active publication profile and may report errors or warnings for missing required metadata, broken internal relationships or other publication issues.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":["HTML"],"translation":""},
+    {"key":"/supplemental/help/topics[17].tips[0]","source":"Resolve blocking errors before export.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[17].tips[1]","source":"Warnings may not always block export, but they should still be reviewed individually.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[17].title","source":"18. HTML and publication validation","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":["HTML"],"translation":""},
+    {"key":"/supplemental/help/topics[18].body","source":"Studio supports local and configurable external storage workflows. WebDAV/Nextcloud availability depends on the installation and user configuration; the semantic OMI format is designed so a manuscript is not locked to one storage provider.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":["OMI"],"translation":""},
+    {"key":"/supplemental/help/topics[18].tips[0]","source":"Verify connection settings before using external storage.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[18].tips[1]","source":"Create a portable OMI package for migration or backup.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":["OMI"],"translation":""},
+    {"key":"/supplemental/help/topics[18].title","source":"19. Cloud and file storage","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[19].body","source":"First determine whether the problem concerns content, structure, metadata, integration or presentation. Check manuscript and metadata languages, section structure, the active publication profile and export diagnostics. For import problems, also inspect the actual source-document structure.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[19].tips[0]","source":"For DOCX, check Word heading styles and note/table structure.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":["DOCX"],"translation":""},
+    {"key":"/supplemental/help/topics[19].tips[1]","source":"For OJS, check Publication metadata, the assignment and permission context.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[19].tips[2]","source":"For PDF/HTML presentation, check the active profile, Export CSS and Print/PDF CSS.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":["HTML"],"translation":""},
+    {"key":"/supplemental/help/topics[19].title","source":"20. If something does not look right","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[2].body","source":"Scholarly metadata includes the title, subtitle, motto, abstract, keywords and document language. Multilingual publication fields can be stored as separate language variants.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[2].tips[0]","source":"The main manuscript language and the language of a metadata value are separate concepts.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[2].tips[1]","source":"A Hungarian manuscript may also contain English and German titles, abstracts and keywords.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[2].tips[2]","source":"The publication profile may make metadata required or recommended.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[2].title","source":"3. Manuscript data, front matter and languages","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[20].body","source":"Studio treats tables of contents and indexes as semantic navigation. When a Word table of contents is imported, Studio builds a live in-document table of contents from the heading hierarchy; selecting an entry navigates directly to its section. Static Word page numbers are not preserved because Studio uses a continuous responsive document model. A manuscript can also contain multiple freely named indexes, such as a name index, place index, or list of figures, with occurrences navigating to their marked location.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[20].tips[0]","source":"Use real heading levels because the table of contents is generated from the heading hierarchy.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[20].tips[1]","source":"Do not manually repair imported TOC page numbers; Studio navigation does not depend on static pagination.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[20].tips[2]","source":"Select an index occurrence to navigate to the corresponding place in the manuscript.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[20].title","source":"Table of contents and indexes","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[21].body","source":"Registered authors can sign a specific manuscript revision with a WebAuthn/passkey credential linked to a securely verified identity such as ORCID. The signature is bound to the cryptographic digest of that exact revision.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":["ORCID"],"translation":""},
+    {"key":"/supplemental/help/topics[21].tips[0]","source":"A manually entered ORCID is not the same as an authenticated ORCID identity.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":["ORCID"],"translation":""},
+    {"key":"/supplemental/help/topics[21].tips[1]","source":"After manuscript changes, the new revision must be signed again.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[21].tips[2]","source":"Each co-author can sign the same revision independently.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[21].title","source":"Cryptographic author signatures","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[22].body","source":"From Publication, an open standalone OMI study can be submitted directly to a configured OJS journal or OMP press. Studio creates a native remote draft, transfers the reviewed metadata plus DOCX and OMI source files, and asks the PKP destination to validate the draft before final submission.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":["OMI","DOCX"],"translation":""},
+    {"key":"/supplemental/help/topics[22].tips[0]","source":"Check the target OJS section or OMP series before preparing the draft.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[22].tips[1]","source":"If preparation is interrupted, retry it: Studio reuses the existing remote draft and avoids duplicate submissions or files.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[22].tips[2]","source":"Resolve every remote validation error before final submission.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[22].title","source":"Direct submission to OJS and OMP","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[23].body","source":"Studio can create a music-score block from MusicXML (.musicxml, .xml) and MIDI (.mid, .midi) files. MusicXML import reads structured notation data including the title, available creator/composer information, time signature, pitch, accidentals, octave, duration, note type, and rests. MIDI import primarily transfers pitch-based note events, so it does not preserve the full semantics or typography of the original score.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":["XML"],"translation":""},
+    {"key":"/supplemental/help/topics[23].tips[0]","source":"Use MusicXML whenever possible for editable, structured notation; MIDI is better suited to transferring pitch data.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":["XML"],"translation":""},
+    {"key":"/supplemental/help/topics[23].tips[1]","source":"MusicXML and MIDI import can be disabled independently in Settings under the import-format options.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":["XML"],"translation":""},
+    {"key":"/supplemental/help/topics[23].tips[2]","source":"After import, verify the notes, time signature, and musical structure because some application-specific notation features may not be transferable.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[23].title","source":"MusicXML and MIDI import","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":["XML"],"translation":""},
+    {"key":"/supplemental/help/topics[3].body","source":"Manage authors and other contributors, their roles, affiliations and ORCID identifiers. Affiliations can also be enriched with ROR data where the lookup service is available.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":["ORCID","ROR"],"translation":""},
+    {"key":"/supplemental/help/topics[3].tips[0]","source":"Persistent identifiers improve machine-readable publication exports.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[3].tips[1]","source":"Check which contributor fields are required by the active publication profile.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[3].title","source":"4. Contributors, affiliations, ORCID and ROR","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":["ORCID","ROR"],"translation":""},
+    {"key":"/supplemental/help/topics[4].body","source":"Footnotes and endnotes are semantic note objects. Notes can contain rich text and citations, while placement is controlled by publication-profile rules.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[4].tips[0]","source":"Do not imitate notes with manually typed superscript numbers.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[4].tips[1]","source":"A source cited in a note can reuse the same bibliographic record as citations in the main text.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[4].title","source":"5. Notes and citations inside notes","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[5].body","source":"Cited works are stored as structured bibliographic records. A record can be reused by multiple inline or note citations. Studio supports citation clusters, CSL-based rendering and bibliographic lookup.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":["CSL"],"translation":""},
+    {"key":"/supplemental/help/topics[5].tips[0]","source":"Do not add the same work repeatedly; reuse its existing record.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[5].tips[1]","source":"Check author, title, year and identifier data before publication export.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[5].title","source":"6. Citations, bibliography and citation style","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[6].body","source":"Internal cross-references can target sections and supported document objects. Because the reference points to the target object, numbering does not have to be rewritten manually when structure changes.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[6].tips[0]","source":"Use a cross-reference instead of typing “see Figure 3” manually where possible.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[6].tips[1]","source":"After deletion or restructuring, review publication diagnostics for missing targets.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[6].title","source":"7. Cross-references","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[7].body","source":"Studio represents scholarly visual content as structured blocks. Figures may have media assets, captions and reference targets; table structure and semantic equation representations can also be carried into supported exports.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[7].tips[0]","source":"Do not build tables with spaces or tabs.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[7].tips[1]","source":"Use meaningful captions and alternative text for figures when available.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[7].tips[2]","source":"Use the equation element instead of an image when there is no specific reason to rasterize a formula.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[7].title","source":"8. Figures, tables and equations","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
+    {"key":"/supplemental/help/topics[8].body","source":"Images and other supported media are attached to the manuscript as assets. A full OMI package can carry these files together with the semantic manuscript and integrity information.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":["OMI"],"translation":""},
+    {"key":"/supplemental/help/topics[8].tips[0]","source":"Use the portable OMI package when media files must travel with the manuscript.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":["OMI"],"translation":""},
+    {"key":"/supplemental/help/topics[8].tips[1]","source":"Package integrity information helps detect missing, damaged or modified content.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":[],"translation":""},
