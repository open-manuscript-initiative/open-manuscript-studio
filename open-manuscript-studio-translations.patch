+    {"key":"/supplemental/help/topics[22].body","source":"From Publication, an open standalone OMI study can be submitted directly to a configured OJS journal or OMP press. Studio creates a native remote draft, transfers the reviewed metadata plus DOCX and OMI source files, and asks the PKP destination to validate the draft before final submission.","kind":"coded-copy","surface":"help","sourceFile":"src/i18n/helpResolver.ts","protectedTerms":["OMI","DOCX"],"translation":""},
