{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Manuscript Studio",
  "version": "0.1.0-alpha.4",
  "identifier": "org.openmanuscript.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Open Manuscript Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["https"],
          "host": "app.openmanuscript.org",
          "pathPrefix": ["/auth/orcid"],
          "appLink": true
        },
        {
          "scheme": ["openmanuscript"],
          "appLink": false
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Portable scholarly manuscript authoring and publishing studio",
    "longDescription": "Open Manuscript Studio is the reference authoring environment for portable, structured scholarly manuscripts using the Open Manuscript Initiative model.",
    "windows": {
      "wix": {
        "version": "0.1.0.4"
      }
    }
  }
}
