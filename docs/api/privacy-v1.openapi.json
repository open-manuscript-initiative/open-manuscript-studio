{
  "openapi": "3.1.0",
  "info": {
    "title": "Studio privacy and partial account overview",
    "version": "1.0.0-draft.1"
  },
  "paths": {
    "/api/v1/privacy": {
      "get": {
        "operationId": "getPrivacyNotice",
        "security": [],
        "description": "Selected server operator notice. configured=false is explicit absence, not a compliance certification.",
        "responses": {
          "200": {
            "description": "Reviewed public notice or explicit absence.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              },
              "X-Request-Id": {
                "description": "Server-generated correlation UUID; never an account identifier.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicPrivacyNotice"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account/data": {
      "get": {
        "operationId": "getAccountOverview",
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "description": "Read-only partial overview for the authenticated account only. No target-user parameter. Not a full access/portability response or manuscript backup. Each collection is capped at 1000 with incompleteSections. GET requires neither idempotency keys nor optimistic write versions.",
        "responses": {
          "200": {
            "description": "Bounded account overview; no authentication secrets or manuscript/review contents.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              },
              "X-Request-Id": {
                "description": "Server-generated correlation UUID; never an account identifier.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Content-Disposition": {
                "schema": {
                  "const": "attachment; filename=\"omi-account-data.json\""
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountOverview"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or inactive-account session.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              },
              "X-Request-Id": {
                "description": "Server-generated correlation UUID; never an account identifier.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrivacyError"
                }
              }
            }
          },
          "404": {
            "description": "Account no longer exists.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              },
              "X-Request-Id": {
                "description": "Server-generated correlation UUID; never an account identifier.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrivacyError"
                }
              }
            }
          },
          "429": {
            "description": "Ten authenticated exports per IP per 15 minutes in this API process, shared across v1 and legacy aliases.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              },
              "X-Request-Id": {
                "description": "Server-generated correlation UUID; never an account identifier.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrivacyError"
                }
              }
            }
          },
          "500": {
            "description": "Export or response validation failed; no private error detail.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              },
              "X-Request-Id": {
                "description": "Server-generated correlation UUID; never an account identifier.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrivacyError"
                }
              }
            }
          },
          "503": {
            "description": "Identity authority unavailable; fail closed.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              },
              "X-Request-Id": {
                "description": "Server-generated correlation UUID; never an account identifier.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrivacyError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "omi_session"
      },
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "PublicPrivacyNotice": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "configured": {
                "type": "boolean",
                "const": false
              }
            },
            "required": [
              "configured"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "configured": {
                "type": "boolean",
                "const": true
              },
              "notice": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "language": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 16
                  },
                  "operatorReviewed": {
                    "type": "boolean",
                    "const": true
                  },
                  "controller": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8000
                      },
                      "postalAddress": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8000
                      },
                      "email": {
                        "type": "string",
                        "format": "email",
                        "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                      },
                      "dpoEmail": {
                        "type": "string",
                        "format": "email",
                        "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                      }
                    },
                    "required": [
                      "name",
                      "postalAddress",
                      "email"
                    ],
                    "additionalProperties": false
                  },
                  "noticeUrl": {
                    "type": "string",
                    "maxLength": 2048,
                    "format": "uri"
                  },
                  "authority": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8000
                      },
                      "url": {
                        "type": "string",
                        "maxLength": 2048,
                        "format": "uri"
                      }
                    },
                    "required": [
                      "name",
                      "url"
                    ],
                    "additionalProperties": false
                  },
                  "processing": {
                    "minItems": 1,
                    "maxItems": 30,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "purpose": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 8000
                        },
                        "categories": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 8000
                        },
                        "legalBasis": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 8000
                        },
                        "retention": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 8000
                        },
                        "recipients": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 8000
                        },
                        "internationalTransfers": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 8000
                        }
                      },
                      "required": [
                        "purpose",
                        "categories",
                        "legalBasis",
                        "retention",
                        "recipients",
                        "internationalTransfers"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "rights": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  },
                  "dataSources": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  },
                  "requiredData": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  },
                  "automatedDecisions": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  },
                  "cookies": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  },
                  "backups": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  },
                  "deletion": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  }
                },
                "required": [
                  "version",
                  "language",
                  "operatorReviewed",
                  "controller",
                  "noticeUrl",
                  "authority",
                  "processing",
                  "rights",
                  "dataSources",
                  "requiredData",
                  "automatedDecisions",
                  "cookies",
                  "backups",
                  "deletion"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "configured",
              "notice"
            ],
            "additionalProperties": false
          }
        ]
      },
      "AccountOverview": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "const": "omi-account-overview/1"
          },
          "exportedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "scope": {
            "type": "string"
          },
          "omitted": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "incompleteSections": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "profileEmails",
                "identities",
                "institutionMemberships",
                "sessions",
                "passkeys"
              ]
            }
          },
          "profile": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "fullName": {
                "type": "string"
              },
              "affiliation": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "affiliationRorId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "country": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "website": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "orcid": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "bio": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "timeZone": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "interfaceLanguage": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "PENDING",
                  "ACTIVE",
                  "SUSPENDED",
                  "DISABLED"
                ]
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "lastLoginAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "workflowRole": {
                "type": "string",
                "enum": [
                  "general",
                  "author",
                  "editor",
                  "reviewer",
                  "translator",
                  "copyeditor",
                  "layout-editor"
                ]
              }
            },
            "required": [
              "id",
              "email",
              "fullName",
              "affiliation",
              "affiliationRorId",
              "country",
              "website",
              "orcid",
              "bio",
              "timeZone",
              "interfaceLanguage",
              "status",
              "createdAt",
              "updatedAt",
              "lastLoginAt",
              "workflowRole"
            ],
            "additionalProperties": false
          },
          "profileEmails": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string"
                },
                "isPrimary": {
                  "type": "boolean"
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                }
              },
              "required": [
                "email",
                "isPrimary",
                "createdAt"
              ],
              "additionalProperties": false
            }
          },
          "identities": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string"
                },
                "issuer": {
                  "type": "string"
                },
                "subject": {
                  "type": "string"
                },
                "displayName": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                "lastUsedAt": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "provider",
                "issuer",
                "subject",
                "displayName",
                "createdAt",
                "lastUsedAt"
              ],
              "additionalProperties": false
            }
          },
          "institutionMemberships": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string"
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                "institution": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "role",
                "createdAt",
                "institution"
              ],
              "additionalProperties": false
            }
          },
          "sessions": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "createdAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                "expiresAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                }
              },
              "required": [
                "createdAt",
                "expiresAt"
              ],
              "additionalProperties": false
            }
          },
          "passkeys": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "deviceType": {
                  "type": "string"
                },
                "backedUp": {
                  "type": "boolean"
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                "lastUsedAt": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "label",
                "deviceType",
                "backedUp",
                "createdAt",
                "lastUsedAt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "schema",
          "exportedAt",
          "scope",
          "omitted",
          "incompleteSections",
          "profile",
          "profileEmails",
          "identities",
          "institutionMemberships",
          "sessions",
          "passkeys"
        ],
        "additionalProperties": false
      },
      "PrivacyError": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "NOT_AUTHENTICATED",
                  "ACCOUNT_NOT_FOUND",
                  "RATE_LIMITED",
                  "ACCOUNT_EXPORT_FAILED",
                  "IDENTITY_UNAVAILABLE"
                ]
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    }
  }
}
