msgid "Source rights / licence"
msgstr "Diritti d'autore / licenza"

#. OMI translation key: /researchModules/transkribus/copy/reviewed
msgctxt "/researchModules/transkribus/copy/reviewed"
msgid "I checked the transcription, its source and the declared rights."
msgstr "Ho verificato la trascrizione, la sua fonte e i diritti dichiarati."

#. OMI translation key: /researchModules/transkribus/copy/section
msgctxt "/researchModules/transkribus/copy/section"
msgid "Insert at the end of this section"
msgstr "Inserire alla fine di questa sezione"

#. OMI translation key: /researchModules/transkribus/copy/noDocument
msgctxt "/researchModules/transkribus/copy/noDocument"
msgid "Open a manuscript to insert the transcription. You can download it now."
msgstr "Apri un manoscritto per inserire la trascrizione. Puoi scaricarlo subito."

#. OMI translation key: /researchModules/transkribus/copy/insert
msgctxt "/researchModules/transkribus/copy/insert"
