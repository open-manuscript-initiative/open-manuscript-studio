msgctxt "/researchModules/transkribus/copy/modelsHint"
msgid "Choose a public text recognition model by name. Studio fills in its ID automatically."
msgstr "Scegli un modello di riconoscimento testuale pubblico in base al nome. Studio inserisce automaticamente il relativo ID."

#. OMI translation key: /researchModules/transkribus/copy/modelsLoading
