msgctxt "/researchModules/transkribus/copy/manualModel"
msgid "Private model / enter an ID"
msgstr "Modello privato / inserisci un ID"

#. OMI translation key: /researchModules/transkribus/copy/manualModelHint
msgctxt "/researchModules/transkribus/copy/manualModelHint"
msgid "For a private model, enter its model ID from your Transkribus account. You can also enter a public model ID if the catalogue is unavailable."
msgstr "Per un modello privato, inserisci l'ID del modello dal tuo account Transkribus. Puoi anche inserire l'ID di un modello pubblico se il catalogo non è disponibile."

