msgstr "Trascrizione riconosciuta"

#. OMI translation key: /researchModules/transkribus/copy/reviewHint
msgctxt "/researchModules/transkribus/copy/reviewHint"
msgid "Compare the result with the original page and correct it before inserting. Machine recognition is not a verified scholarly transcription."
msgstr "Confronta il risultato con la pagina originale e correggilo prima di inserirlo. Il riconoscimento automatico non costituisce una trascrizione accademica verificata."

#. OMI translation key: /researchModules/transkribus/copy/source
msgctxt "/researchModules/transkribus/copy/source"
msgid "Source"
msgstr "Sorgente"

#. OMI translation key: /researchModules/transkribus/copy/sourceHint
msgctxt "/researchModules/transkribus/copy/sourceHint"
msgid "Replace the suggested filename with the repository, shelfmark, page or stable source URL. Rights are declared by you; Studio does not infer a licence."
msgstr "Sostituisci il nome del file suggerito con il repository, la sigla di classificazione, la pagina o l'URL stabile della fonte. I diritti sono dichiarati dall'utente; Studio non deduce alcuna licenza."

