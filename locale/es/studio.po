msgctxt "/modules/htmlExport/downloadPackage"
msgid "Download HTML package"
msgstr "Descargar paquete HTML"

#. OMI translation key: /modules/htmlExport/preparingPackage
msgctxt "/modules/htmlExport/preparingPackage"
msgid "Preparing package…"
msgstr "Preparando el paquete…"

#. OMI translation key: /modules/htmlExport/exportReady
msgctxt "/modules/htmlExport/exportReady"
msgid "The HTML rendering has no blocking diagnostics."
msgstr "La generación de HTML no presenta errores de diagnóstico que impidan su ejecución."

#. OMI translation key: /modules/htmlExport/exportHasErrors
msgctxt "/modules/htmlExport/exportHasErrors"
msgid "The HTML can be inspected, but blocking diagnostics must be resolved before a publication package is created."
msgstr "Se puede revisar el código HTML, pero es necesario resolver los errores de diagnóstico que impiden la publicación antes de crear un paquete de publicación."

#. OMI translation key: /modules/htmlExport/errors
msgctxt "/modules/htmlExport/errors"
msgid "errors"
msgstr "errores"

#. OMI translation key: /modules/htmlExport/warnings
msgctxt "/modules/htmlExport/warnings"
msgid "warnings"
msgstr "advertencias"

#. OMI translation key: /modules/htmlExport/diagnostics
msgctxt "/modules/htmlExport/diagnostics"
msgid "HTML diagnostics"
msgstr "Diagnóstico HTML"

#. OMI translation key: /modules/htmlExport/noDiagnostics
msgctxt "/modules/htmlExport/noDiagnostics"
msgid "No HTML-specific diagnostics."
msgstr "No hay diagnósticos específicos de HTML."

#. OMI translation key: /modules/htmlExport/workingPreview
msgctxt "/modules/htmlExport/workingPreview"
msgid "The preview reflects the current working state. Package download creates a checkpoint first so the output is traceable to a committed revision."
msgstr "La vista previa refleja el estado actual del trabajo. La descarga del paquete crea primero un punto de control, de modo que el resultado se puede rastrear hasta una revisión confirmada."

#. OMI translation key: /modules/htmlExport/unsupportedProfile
msgctxt "/modules/htmlExport/unsupportedProfile"
msgid "The active profile does not declare HTML as a supported output."
msgstr "El perfil activo no declara el HTML como formato de salida compatible."

#. OMI translation key: /modules/htmlExport/accessibilityNote
msgctxt "/modules/htmlExport/accessibilityNote"
msgid "The renderer uses semantic headings, figures, tables, document-note roles, bibliography links and explicit image alt attributes. External accessibility auditing remains a separate publication step."
msgstr "El generador utiliza encabezados semánticos, figuras, tablas, notas del documento, enlaces a la bibliografía y atributos «alt» explícitos para las imágenes. La auditoría externa de accesibilidad sigue siendo un paso independiente del proceso de publicación."

#. OMI translation key: /modules/htmlExport/packageNote
msgctxt "/modules/htmlExport/packageNote"
msgid "The ZIP package contains index.html, a manifest and referenced media assets under relative media/ paths. No script or external stylesheet is required."
msgstr "El paquete ZIP contiene el archivo index.html, un manifiesto y los recursos multimedia a los que se hace referencia en las rutas relativas de la carpeta «media/». No se requiere ningún script ni hoja de estilo externa."

#. OMI translation key: /modules/jatsExport/title
msgctxt "/modules/jatsExport/title"
msgid "JATS XML"
msgstr "JATS XML"

#. OMI translation key: /modules/jatsExport/description
msgctxt "/modules/jatsExport/description"
msgid "Render the semantic manuscript through the active Publication Profile as NISO JATS 1.4 Article Authoring XML."
msgstr "Representa el manuscrito semántico mediante el perfil de publicación activo como XML de redacción de artículos NISO JATS 1.4."

