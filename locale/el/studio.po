msgstr "Προσθήκη δημιουργού"

#. OMI translation key: /citations/removeCreator
msgctxt "/citations/removeCreator"
msgid "Remove creator"
msgstr "Διαγραφή δημιουργού"

#. OMI translation key: /citations/noCreators
