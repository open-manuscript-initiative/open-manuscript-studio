msgctxt "/notes/authorNote"
msgid "Author note"
msgstr "Σημείωση συγγραφέα"

#. OMI translation key: /notes/delete
msgctxt "/notes/delete"
msgid "Delete note"
msgstr "Διαγραφή σημείωσης"

#. OMI translation key: /notes/confirmDelete
msgctxt "/notes/confirmDelete"
msgid "Delete this note and its inline anchor from the manuscript?"
msgstr "Θέλετε να διαγράψετε αυτή τη σημείωση και τον ενσωματωμένο σύνδεσμό της από το χειρόγραφο;"

#. OMI translation key: /notes/closeEditor
msgctxt "/notes/closeEditor"
msgid "Close note editor"
msgstr "Κλείσιμο επεξεργαστή σημειώσεων"

#. OMI translation key: /notes/goToNote
msgctxt "/notes/goToNote"
msgid "Go to note"
msgstr "Μετάβαση στη σημείωση"

#. OMI translation key: /notes/autoSave
msgctxt "/notes/autoSave"
msgid "Saved with manuscript revisions"
msgstr "Αποθηκεύτηκε μαζί με τις αναθεωρήσεις του χειρογράφου"

#. OMI translation key: /citations/referencesTitle
msgctxt "/citations/referencesTitle"
msgid "References"
msgstr "Αναφορές"

#. OMI translation key: /citations/referencesDescription
msgctxt "/citations/referencesDescription"
msgid "Add a work once to the manuscript reference library, then reuse it in as many citation occurrences as needed."
msgstr "Προσθέστε ένα έργο μία φορά στη βιβλιοθήκη αναφορών του χειρογράφου και, στη συνέχεια, επαναχρησιμοποιήστε το σε όσες αναφορές χρειαστεί."

#. OMI translation key: /citations/addReference
msgctxt "/citations/addReference"
msgid "Add reference"
msgstr "Προσθήκη αναφοράς"

#. OMI translation key: /citations/editReference
msgctxt "/citations/editReference"
msgid "Edit reference"
msgstr "Επεξεργασία αναφοράς"

#. OMI translation key: /citations/referenceEditorDescription
msgctxt "/citations/referenceEditorDescription"
msgid "Store structured bibliographic metadata independently from any one citation or output style."
msgstr "Αποθηκεύστε δομημένα βιβλιογραφικά μεταδεδομένα ανεξάρτητα από οποιαδήποτε συγκεκριμένη αναφορά ή στυλ εξόδου."

#. OMI translation key: /citations/emptyLibrary
msgctxt "/citations/emptyLibrary"
msgid "The manuscript reference library is empty."
msgstr "Η βιβλιοθήκη αναφορών του χειρογράφου είναι κενή."

#. OMI translation key: /citations/emptyLibraryHint
msgctxt "/citations/emptyLibraryHint"
msgid "Add a book, article, archival source, web resource or another cited work before inserting citations in the text."
msgstr "Προσθέστε ένα βιβλίο, άρθρο, αρχειακή πηγή, διαδικτυακό πόρο ή άλλο έργο που αναφέρεται πριν εισαγάγετε αναφορές στο κείμενο."

#. OMI translation key: /citations/searchReferences
msgctxt "/citations/searchReferences"
msgid "Search references"
msgstr "Αναζήτηση αναφορών"

#. OMI translation key: /citations/searchPlaceholder
msgctxt "/citations/searchPlaceholder"
msgid "Search by title, creator, year, DOI…"
msgstr "Αναζήτηση κατά τίτλο, δημιουργό, έτος, DOI…"

#. OMI translation key: /citations/untitledReference
msgctxt "/citations/untitledReference"
msgid "Untitled reference"
msgstr "Αναφορά χωρίς τίτλο"

#. OMI translation key: /citations/occurrences
msgctxt "/citations/occurrences"
msgid "citations"
msgstr "αναφορές"

#. OMI translation key: /citations/bibliographyPreviewDescription
msgctxt "/citations/bibliographyPreviewDescription"
msgid "Neutral preview of records currently cited in the manuscript. Final formatting belongs to the publication profile."
msgstr "Ουδέτερη προεπισκόπηση των εγγραφών που αναφέρονται επί του παρόντος στο χειρόγραφο. Η τελική μορφοποίηση εξαρτάται από το προφίλ δημοσίευσης."

#. OMI translation key: /citations/resourceType
msgctxt "/citations/resourceType"
msgid "Resource type"
msgstr "Τύπος πηγής"

#. OMI translation key: /citations/title
msgctxt "/citations/title"
msgid "Title"
msgstr "Τίτλος"

#. OMI translation key: /citations/titlePlaceholder
msgctxt "/citations/titlePlaceholder"
msgid "Title of the cited work"
msgstr "Τίτλος του αναφερόμενου έργου"

#. OMI translation key: /citations/subtitle
msgctxt "/citations/subtitle"
msgid "Subtitle"
msgstr "Υπότιτλος"

#. OMI translation key: /citations/creators
msgctxt "/citations/creators"
msgid "Creators and contributors"
msgstr "Δημιουργοί και συνεισφέροντες"

#. OMI translation key: /citations/creatorsDescription
msgctxt "/citations/creatorsDescription"
msgid "Keep contributor names structured so citation styles and exports can render them correctly."
msgstr "Διατηρήστε τα ονόματα των συντελεστών δομημένα, ώστε οι μορφές παραπομπής και οι εξαγωγές να μπορούν να τα αποδίδουν σωστά."

#. OMI translation key: /citations/addCreator
msgctxt "/citations/addCreator"
