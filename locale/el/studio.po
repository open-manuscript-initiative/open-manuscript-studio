msgstr "Σελίδες / έκταση"

#. OMI translation key: /citations/publisher
msgctxt "/citations/publisher"
msgid "Publisher"
msgstr "Εκδότης"

#. OMI translation key: /citations/place
msgctxt "/citations/place"
