#. OMI translation key: /modules/help/navigation
msgctxt "/modules/help/navigation"
msgid "Help"
msgstr "Nápověda"

#. OMI translation key: /modules/help/title
msgctxt "/modules/help/title"
msgid "Help for authors"
msgstr "Nápověda pro autory"

#. OMI translation key: /modules/help/description
msgctxt "/modules/help/description"
msgid "A short guide to editing manuscripts and using the main Studio features."
msgstr "Stručný průvodce úpravou rukopisů a používáním hlavních funkcí Studia."

#. OMI translation key: /modules/help/gettingStarted
msgctxt "/modules/help/gettingStarted"
msgid "When a manuscript is opened from OJS, Studio imports the document and available publication metadata. Editing then takes place in the Studio manuscript model."
msgstr "Při otevření rukopisu z OJS Studio importuje dokument a dostupná publikační metadata. Další úpravy probíhají v modelu rukopisu Studia."

#. OMI translation key: /modules/help/topics/0/title
msgctxt "/modules/help/topics/0/title"
msgid "Editing the manuscript"
msgstr "Úprava rukopisu"

#. OMI translation key: /modules/help/topics/0/body
msgctxt "/modules/help/topics/0/body"
msgid "Edit manuscript text in the main editor. Review its structure under Manuscript menu → Document."
msgstr "Text rukopisu upravujte v hlavním editoru. Jeho strukturu zkontrolujte v nabídce Rukopis → Dokument."

#. OMI translation key: /modules/help/topics/0/tips/0
msgctxt "/modules/help/topics/0/tips/0"
msgid "Use real heading styles for section headings."
msgstr "Pro nadpisy oddílů používejte skutečné styly nadpisů."

#. OMI translation key: /modules/help/topics/0/tips/1
msgctxt "/modules/help/topics/0/tips/1"
msgid "Do not rely on bold text or font size alone to express structure."
msgstr "Pro vyjádření struktury nespoléhejte pouze na tučné písmo nebo velikost fontu."

#. OMI translation key: /modules/help/topics/1/title
msgctxt "/modules/help/topics/1/title"
msgid "Manuscript data and languages"
msgstr "Data rukopisu a jazyky"

#. OMI translation key: /modules/help/topics/1/body
msgctxt "/modules/help/topics/1/body"
msgid "Abstracts, keywords and other scholarly metadata are edited under Manuscript data. Multilingual fields can be maintained separately in HU, EN and DE."
msgstr "Abstrakty, klíčová slova a další odborná metadata se upravují v části Data rukopisu. Vícejazyčná pole lze udržovat samostatně v HU, EN a DE."

#. OMI translation key: /modules/help/topics/1/tips/0
msgctxt "/modules/help/topics/1/tips/0"
msgid "The manuscript language and metadata language are separate concepts."
msgstr "Jazyk rukopisu a jazyk metadat jsou odlišné pojmy."

#. OMI translation key: /modules/help/topics/1/tips/1
msgctxt "/modules/help/topics/1/tips/1"
msgid "A Hungarian article may also have English and German abstracts and keywords."
msgstr "Maďarský článek může mít také anglický a německý abstrakt a klíčová slova."

#. OMI translation key: /modules/help/topics/2/title
msgctxt "/modules/help/topics/2/title"
msgid "Notes"
msgstr "Poznámky"

#. OMI translation key: /modules/help/topics/2/body
msgctxt "/modules/help/topics/2/body"
msgid "Footnotes and endnotes are retained as semantic note objects. Review and edit them under Notes."
msgstr "Poznámky pod čarou a koncové poznámky se zachovávají jako sémantické objekty poznámek. Prohlížejte a upravujte je v části Poznámky."

#. OMI translation key: /modules/help/topics/3/title
msgctxt "/modules/help/topics/3/title"
msgid "References"
msgstr "Reference"

#. OMI translation key: /modules/help/topics/3/body
msgctxt "/modules/help/topics/3/body"
msgid "Cited works are stored as structured bibliographic records. Add a work once and reuse it in multiple citations."
msgstr "Citovaná díla jsou uložena jako strukturované bibliografické záznamy. Dílo přidejte jednou a znovu je používejte ve více citacích."

#. OMI translation key: /modules/help/topics/4/title
msgctxt "/modules/help/topics/4/title"
msgid "Contributors"
msgstr "Přispěvatelé"

#. OMI translation key: /modules/help/topics/4/body
msgctxt "/modules/help/topics/4/body"
msgid "Manage authors and other contributors, roles, affiliations and ORCID identifiers here."
msgstr "Zde spravujte autory a další přispěvatele, role, afiliace a identifikátory ORCID."

#. OMI translation key: /modules/help/topics/5/title
msgctxt "/modules/help/topics/5/title"
msgid "Revisions and saving"
msgstr "Revize a ukládání"

#. OMI translation key: /modules/help/topics/5/body
msgctxt "/modules/help/topics/5/body"
msgid "Studio tracks important changes as revisions. Use History to review changes and, where supported, return to an earlier state."
msgstr "Studio sleduje důležité změny jako revize. Pomocí Historie změny prohlížejte a tam, kde je to podporováno, se vraťte k dřívějšímu stavu."

#. OMI translation key: /modules/help/topics/6/title
msgctxt "/modules/help/topics/6/title"
msgid "Import from OJS"
msgstr "Import z OJS"

#. OMI translation key: /modules/help/topics/6/body
msgctxt "/modules/help/topics/6/body"
msgid "Studio can import the document, abstracts, keywords and other publication metadata from OJS. Only metadata actually present in OJS can be imported."
msgstr "Studio může z OJS importovat dokument, abstrakty, klíčová slova a další publikační metadata. Importovat lze pouze metadata skutečně přítomná v OJS."

#. OMI translation key: /modules/help/topics/7/title
msgctxt "/modules/help/topics/7/title"
msgid "DOCX import"
msgstr "Import DOCX"

#. OMI translation key: /modules/help/topics/7/body
msgctxt "/modules/help/topics/7/body"
msgid "When importing Word documents, Studio also attempts to recover document structure."
msgstr "Při importu dokumentů Word se Studio pokouší obnovit také strukturu dokumentu."

#. OMI translation key: /modules/help/topics/7/tips/0
msgctxt "/modules/help/topics/7/tips/0"
msgid "Use Word Heading 1, Heading 2, etc. for section headings."
msgstr "Pro nadpisy oddílů používejte ve Wordu Nadpis 1, Nadpis 2 atd."

#. OMI translation key: /modules/help/topics/7/tips/1
msgctxt "/modules/help/topics/7/tips/1"
msgid "Direct-formatting recognition is only a fallback."
msgstr "Rozpoznávání přímého formátování je pouze záložní metoda."

#. OMI translation key: /modules/help/topics/8/title
msgctxt "/modules/help/topics/8/title"
msgid "Export"
msgstr "Export"

#. OMI translation key: /modules/help/topics/8/body
msgctxt "/modules/help/topics/8/body"
msgid "Export & tools can create a portable .omi.json manuscript file containing the semantic document structure and OMI metadata."
msgstr "Export a nástroje mohou vytvořit přenosný soubor rukopisu .omi.json obsahující sémantickou strukturu dokumentu a metadata OMI."

#. OMI translation key: /modules/help/topics/9/title
msgctxt "/modules/help/topics/9/title"
msgid "If something looks wrong"
msgstr "Když něco nevypadá správně"

#. OMI translation key: /modules/help/topics/9/body
msgctxt "/modules/help/topics/9/body"
msgid "Check the manuscript language, selected metadata language and, for Word imports, heading styles. For OJS imports, also verify that the value is actually filled in under the OJS Publication metadata."
msgstr "Zkontrolujte jazyk rukopisu, zvolený jazyk metadat a u importu Wordu styly nadpisů. U importu OJS také ověřte, zda je hodnota skutečně vyplněna v publikačních metadatech OJS."

#. OMI translation key: /modules/htmlExport/title
msgctxt "/modules/htmlExport/title"
msgid "Semantic HTML5"
msgstr "Sémantické HTML5"

#. OMI translation key: /modules/htmlExport/description
msgctxt "/modules/htmlExport/description"
msgid "Render the semantic manuscript through the active Publication Profile as an accessible, script-free HTML5 scholarly article."
msgstr "Vyrenderujte sémantický rukopis prostřednictvím aktivního publikačního profilu jako přístupný odborný článek HTML5 bez skriptů."

