msgctxt "/researchModules/transkribus/copy/errors/TRANSKRIBUS_MODELS_UNAVAILABLE"
msgid "The public model catalogue could not be loaded. Try again or enter a model ID manually."
msgstr "Nie udało się załadować publicznego katalogu modeli. Spróbuj ponownie lub wprowadź identyfikator modelu ręcznie."

#. OMI translation key: /uncataloguedUi/euroOfficeRecovery/title
msgctxt "/uncataloguedUi/euroOfficeRecovery/title"
msgid "Recovery saves"
msgstr "Odzyskiwanie zapisów"

#. OMI translation key: /uncataloguedUi/euroOfficeRecovery/description
msgctxt "/uncataloguedUi/euroOfficeRecovery/description"
msgid "Force saves and conflicting callbacks are retained here. Final content is committed when the editor closes. Download a snapshot to recover it; this does not replace the current document."
msgstr "W tym miejscu zapisywane są wymuszone zapisy i sprzeczne wywołania zwrotne. Ostateczna zawartość jest zatwierdzana po zamknięciu edytora. Pobierz migawkę, aby przywrócić zawartość; nie zastąpi to bieżącego dokumentu."

#. OMI translation key: /uncataloguedUi/euroOfficeRecovery/loading
msgctxt "/uncataloguedUi/euroOfficeRecovery/loading"
msgid "Loading…"
msgstr "Wczytywanie…"

#. OMI translation key: /uncataloguedUi/euroOfficeRecovery/empty
msgctxt "/uncataloguedUi/euroOfficeRecovery/empty"
msgid "No saved snapshots."
msgstr "Brak zapisanych migawek."

#. OMI translation key: /uncataloguedUi/euroOfficeRecovery/final
msgctxt "/uncataloguedUi/euroOfficeRecovery/final"
msgid "Final save"
msgstr "Zapisanie ostatecznej wersji"

#. OMI translation key: /uncataloguedUi/euroOfficeRecovery/previous
msgctxt "/uncataloguedUi/euroOfficeRecovery/previous"
msgid "Previous document"
msgstr "Poprzedni dokument"

#. OMI translation key: /uncataloguedUi/euroOfficeRecovery/recovery
msgctxt "/uncataloguedUi/euroOfficeRecovery/recovery"
msgid "Recovery snapshot"
msgstr "Migawka odzyskiwania"

#. OMI translation key: /uncataloguedUi/euroOfficeRecovery/failed
msgctxt "/uncataloguedUi/euroOfficeRecovery/failed"
msgid "Recovery saves could not be loaded or downloaded."
msgstr "Nie udało się załadować ani pobrać plików odzyskiwania."

#. OMI translation key: /researchModules/history-archives-siusa-search-panel/copyByLocale/title
msgctxt "/researchModules/history-archives-siusa-search-panel/copyByLocale/title"
msgid "SIUSA — Italian archival descriptions"
msgstr "SIUSA – włoskie archiwa"

#. OMI translation key: /researchModules/history-archives-siusa-search-panel/copyByLocale/description
msgctxt "/researchModules/history-archives-siusa-search-panel/copyByLocale/description"
msgid "Search SIUSA, the Italian national information system for non-state archives. Results open in the official catalogue in a new tab."
msgstr "Przeszukuj SIUSA, włoski krajowy system informacji o archiwach niepaństwowych. Wyniki otwierają się w nowej karcie w oficjalnym katalogu."

#. OMI translation key: /researchModules/history-archives-siusa-search-panel/copyByLocale/label
msgctxt "/researchModules/history-archives-siusa-search-panel/copyByLocale/label"
msgid "Search SIUSA archives"
msgstr "Szukaj w archiwach SIUSA"

