msgctxt "/notes/empty"
msgid "This manuscript has no notes yet."
msgstr "Ten rękopis nie zawiera jeszcze żadnych notatek."

#. OMI translation key: /notes/emptyHint
msgctxt "/notes/emptyHint"
msgid "Place the cursor in the text and use the Note button or Ctrl/Cmd+Alt+N."
msgstr "Umieść kursor w tekście i użyj przycisku „Notatka” lub skrótu klawiszowego Ctrl/Cmd+Alt+N."

