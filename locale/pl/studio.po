msgid "Notes"
msgstr "Notatki"

#. OMI translation key: /notes/description
msgctxt "/notes/description"
msgid "Manage semantic manuscript notes. Note bodies remain independent annotation objects while their inline anchors stay in the text."
msgstr "Zarządzaj semantycznymi notatkami w manuskrypcie. Treści notatek pozostają niezależnymi obiektami adnotacji, podczas gdy ich kotwice wbudowane pozostają w tekście."

