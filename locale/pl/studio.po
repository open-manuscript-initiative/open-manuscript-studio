msgid "Title block"
msgstr "Blok tytułowy"

#. OMI translation key: /modules/frontMatter/frontMatterDescription
msgctxt "/modules/frontMatter/frontMatterDescription"
msgid "Subtitle and motto are independent optional scholarly front-matter fields."
msgstr "Podtytuł i motto to niezależne, opcjonalne pola naukowe w części wstępnej."

#. OMI translation key: /modules/frontMatter/optional
