#. OMI translation key: /researchModules/transkribus/copy/imageHint
msgctxt "/researchModules/transkribus/copy/imageHint"
msgid "JPEG, PNG or TIFF; one page per job, up to 20 MB. Convert PDF pages to images first."
msgstr "JPEG, PNG lub TIFF; jedna strona na zadanie, maksymalnie 20 MB. Najpierw przekonwertuj strony PDF na obrazy."

#. OMI translation key: /researchModules/transkribus/copy/modelId
msgctxt "/researchModules/transkribus/copy/modelId"
msgid "Recognition model ID"
msgstr "Identyfikator modelu rozpoznawania"

#. OMI translation key: /researchModules/transkribus/copy/models
