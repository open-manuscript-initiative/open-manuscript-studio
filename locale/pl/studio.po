msgstr "Nazwa, archiwum, miejsce lub słowo kluczowe"

#. OMI translation key: /researchModules/history-archives-siusa-search-panel/copyByLocale/search
msgctxt "/researchModules/history-archives-siusa-search-panel/copyByLocale/search"
msgid "Search SIUSA"
msgstr "Szukaj w SIUSA"

msgctxt "/translationModel/title"
msgid "Translations"
msgstr "Tłumaczenia"

msgctxt "/translationModel/description"
msgid "Create and review aligned language variants. Source edits flag affected translations for review; target text remains editable. Variants are saved inside the OMI manuscript."
msgstr "Twórz i sprawdzaj wyrównane wersje językowe. Zmiany źródła oznaczają tłumaczenia wymagające kontroli; tekst docelowy pozostaje edytowalny. Wersje są zapisywane w manuskrypcie OMI."

