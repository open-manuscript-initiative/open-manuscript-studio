msgstr "Eredeti nyelv"

#. OMI translation key: /notes/title
msgctxt "/notes/title"
msgid "Notes"
msgstr "Megjegyzések"

#. OMI translation key: /notes/description
msgctxt "/notes/description"
msgid "Manage semantic manuscript notes. Note bodies remain independent annotation objects while their inline anchors stay in the text."
msgstr "Szemantikus kézirati megjegyzések kezelése. A megjegyzések szövege önálló megjegyzés-objektumként marad, míg a szövegbe ágyazott hivatkozásaik a szövegben maradnak."

#. OMI translation key: /notes/empty
msgctxt "/notes/empty"
msgid "This manuscript has no notes yet."
msgstr "Ehhez a kézirathoz még nincsenek megjegyzések."

#. OMI translation key: /notes/emptyHint
msgctxt "/notes/emptyHint"
msgid "Place the cursor in the text and use the Note button or Ctrl/Cmd+Alt+N."
msgstr "Helyezze a kurzort a szövegbe, majd kattintson a „Jegyzet” gombra, vagy nyomja meg a Ctrl/Cmd+Alt+N billentyűkombinációt."

#. OMI translation key: /notes/note
msgctxt "/notes/note"
msgid "Note"
msgstr "Megjegyzés"

#. OMI translation key: /notes/type
msgctxt "/notes/type"
msgid "Note type"
msgstr "Megjegyzés típusa"

#. OMI translation key: /notes/body
msgctxt "/notes/body"
msgid "Note text"
msgstr "Megjegyzés szövege"

#. OMI translation key: /notes/bodyPlaceholder
msgctxt "/notes/bodyPlaceholder"
msgid "Write the note…"
msgstr "Írd meg a jegyzetet…"

#. OMI translation key: /notes/footnote
msgctxt "/notes/footnote"
msgid "Footnote"
msgstr "Lábjegyzet"

#. OMI translation key: /notes/endnote
msgctxt "/notes/endnote"
msgid "Endnote"
msgstr "Záró megjegyzés"

#. OMI translation key: /notes/authorNote
msgctxt "/notes/authorNote"
msgid "Author note"
msgstr "A szerző megjegyzése"

#. OMI translation key: /notes/delete
msgctxt "/notes/delete"
msgid "Delete note"
msgstr "Megjegyzés törlése"

#. OMI translation key: /notes/confirmDelete
msgctxt "/notes/confirmDelete"
msgid "Delete this note and its inline anchor from the manuscript?"
msgstr "Töröljük ezt a megjegyzést és a hozzá tartozó beágyazott hivatkozást a kéziratból?"

#. OMI translation key: /notes/closeEditor
msgctxt "/notes/closeEditor"
msgid "Close note editor"
msgstr "A jegyzetszerkesztő bezárása"

#. OMI translation key: /notes/goToNote
msgctxt "/notes/goToNote"
msgid "Go to note"
msgstr "Ugrás a megjegyzésre"

#. OMI translation key: /notes/autoSave
msgctxt "/notes/autoSave"
msgid "Saved with manuscript revisions"
msgstr "A kézirat módosításainak mentése"

#. OMI translation key: /citations/referencesTitle
msgctxt "/citations/referencesTitle"
msgid "References"
msgstr "References (Idegen kulcsok létrehozása)"

#. OMI translation key: /citations/referencesDescription
msgctxt "/citations/referencesDescription"
msgid "Add a work once to the manuscript reference library, then reuse it in as many citation occurrences as needed."
msgstr "Adja hozzá a művet egyszer a kézirat hivatkozási könyvtárához, majd használja újra annyi hivatkozásban, amennyiben szükséges."

#. OMI translation key: /citations/addReference
msgctxt "/citations/addReference"
msgid "Add reference"
msgstr "Hivatkozás hozzáadása"

#. OMI translation key: /citations/editReference
msgctxt "/citations/editReference"
msgid "Edit reference"
msgstr "Hivatkozás szerkesztése"

#. OMI translation key: /citations/referenceEditorDescription
msgctxt "/citations/referenceEditorDescription"
msgid "Store structured bibliographic metadata independently from any one citation or output style."
msgstr "A strukturált bibliográfiai metaadatokat bármely hivatkozási vagy formázási stílustól függetlenül tárolja."

#. OMI translation key: /citations/emptyLibrary
msgctxt "/citations/emptyLibrary"
msgid "The manuscript reference library is empty."
msgstr "A kézirattár üres."

#. OMI translation key: /citations/emptyLibraryHint
msgctxt "/citations/emptyLibraryHint"
msgid "Add a book, article, archival source, web resource or another cited work before inserting citations in the text."
msgstr "Mielőtt hivatkozásokat illesztene a szövegbe, adjon hozzá egy könyvet, cikket, levéltári forrást, internetes forrást vagy más hivatkozott művet."

#. OMI translation key: /citations/searchReferences
msgctxt "/citations/searchReferences"
msgid "Search references"
msgstr "Hivatkozások keresése"

#. OMI translation key: /citations/searchPlaceholder
msgctxt "/citations/searchPlaceholder"
msgid "Search by title, creator, year, DOI…"
msgstr "Keresés cím, szerző, év, DOI alapján…"

#. OMI translation key: /citations/untitledReference
msgctxt "/citations/untitledReference"
msgid "Untitled reference"
msgstr "Cím nélküli hivatkozás"

#. OMI translation key: /citations/occurrences
msgctxt "/citations/occurrences"
msgid "citations"
msgstr "hivatkozások"

#. OMI translation key: /citations/bibliographyPreviewDescription
msgctxt "/citations/bibliographyPreviewDescription"
msgid "Neutral preview of records currently cited in the manuscript. Final formatting belongs to the publication profile."
msgstr "A kéziratban jelenleg hivatkozott rekordok semleges előnézete. A végleges formázás a publikációs profilhoz tartozik."

#. OMI translation key: /citations/resourceType
msgctxt "/citations/resourceType"
msgid "Resource type"
msgstr "Erőforrás-típus"

#. OMI translation key: /citations/title
msgctxt "/citations/title"
msgid "Title"
msgstr "Cím"

#. OMI translation key: /citations/titlePlaceholder
msgctxt "/citations/titlePlaceholder"
msgid "Title of the cited work"
msgstr "Az idézett mű címe"

#. OMI translation key: /citations/subtitle
msgctxt "/citations/subtitle"
msgid "Subtitle"
msgstr "Alcím"

#. OMI translation key: /citations/creators
msgctxt "/citations/creators"
msgid "Creators and contributors"
msgstr "Alkotók és közreműködők"

#. OMI translation key: /citations/creatorsDescription
msgctxt "/citations/creatorsDescription"
msgid "Keep contributor names structured so citation styles and exports can render them correctly."
msgstr "A közreműködők nevét úgy kell megadni, hogy azok a hivatkozási stílusok és az exportálási funkciók által helyesen jelenjenek meg."

#. OMI translation key: /citations/addCreator
msgctxt "/citations/addCreator"
msgid "Add creator"
msgstr "Alkotó hozzáadása"

#. OMI translation key: /citations/removeCreator
msgctxt "/citations/removeCreator"
msgid "Remove creator"
msgstr "Alkotó eltávolítása"

#. OMI translation key: /citations/noCreators
msgctxt "/citations/noCreators"
msgid "No creator has been added."
msgstr "Nem került hozzáadva alkotó."

#. OMI translation key: /citations/creatorRole
msgctxt "/citations/creatorRole"
msgid "Role"
msgstr "Szerepkör"

#. OMI translation key: /citations/givenName
msgctxt "/citations/givenName"
msgid "Given name"
msgstr "Keresztnév"

#. OMI translation key: /citations/familyName
msgctxt "/citations/familyName"
msgid "Family name"
msgstr "Vezetéknév"

#. OMI translation key: /citations/containerTitle
msgctxt "/citations/containerTitle"
msgid "Journal, book or container title"
msgstr "Folyóirat, könyv vagy kiadvány címe"

#. OMI translation key: /citations/issued
msgctxt "/citations/issued"
msgid "Publication date / year"
msgstr "Közzététel dátuma / éve"

#. OMI translation key: /citations/volume
msgctxt "/citations/volume"
msgid "Volume"
msgstr "Térfogat"

#. OMI translation key: /citations/issue
msgctxt "/citations/issue"
msgid "Issue"
msgstr "Probléma"

#. OMI translation key: /citations/pages
msgctxt "/citations/pages"
msgid "Pages / extent"
msgstr "Oldalak / terjedelem"

#. OMI translation key: /citations/publisher
msgctxt "/citations/publisher"
msgid "Publisher"
msgstr "Kiadó"

#. OMI translation key: /citations/place
msgctxt "/citations/place"
msgid "Place of publication"
msgstr "Kiadás helye"

#. OMI translation key: /citations/duplicateReference
msgctxt "/citations/duplicateReference"
msgid "A likely duplicate already exists in the reference library:"
msgstr "Valószínűleg már létezik egy hasonló bejegyzés a hivatkozási könyvtárban:"

#. OMI translation key: /citations/insertTitle
msgctxt "/citations/insertTitle"
msgid "Insert citation"
msgstr "Hivatkozás beillesztése"

#. OMI translation key: /citations/insertDescription
msgctxt "/citations/insertDescription"
msgid "Choose a work from the manuscript reference library and optionally specify the cited location."
msgstr "Válasszon ki egy művet a kézirattárból, és ha szükséges, adja meg az idézés helyét."

#. OMI translation key: /citations/noReferences
msgctxt "/citations/noReferences"
msgid "No reference is available yet."
msgstr "Még nincs hivatkozás."

#. OMI translation key: /citations/noReferencesHint
msgctxt "/citations/noReferencesHint"
msgid "Add the work from Manuscript menu → References, then return here to cite it."
msgstr "Válassza a „Kézirat” menü → „Hivatkozások” menüpontot a mű hozzáadásához, majd térjen vissza ide a hivatkozás megadásához."

#. OMI translation key: /citations/insert
msgctxt "/citations/insert"
msgid "Insert citation"
msgstr "Hivatkozás beillesztése"

#. OMI translation key: /citations/citation
msgctxt "/citations/citation"
msgid "Citation"
msgstr "Hivatkozás"

#. OMI translation key: /citations/reference
msgctxt "/citations/reference"
msgid "Cited work"
msgstr "Hivatkozott mű"

#. OMI translation key: /citations/locatorType
msgctxt "/citations/locatorType"
msgid "Locator type"
msgstr "Helymeghatározó típus"

#. OMI translation key: /citations/locator
msgctxt "/citations/locator"
msgid "Locator"
msgstr "Helymeghatározó"

#. OMI translation key: /citations/locatorPlaceholder
msgctxt "/citations/locatorPlaceholder"
msgid "e.g. 45–47, 12r–13v, chapter 4"
msgstr "pl. 45–47, 12r–13v, 4. fejezet"

#. OMI translation key: /citations/prefix
msgctxt "/citations/prefix"
msgid "Prefix"
msgstr "Előtag"

#. OMI translation key: /citations/prefixPlaceholder
msgctxt "/citations/prefixPlaceholder"
msgid "e.g. see also"
msgstr "pl. lásd még"

#. OMI translation key: /citations/suffix
msgctxt "/citations/suffix"
msgid "Suffix"
msgstr "Utótag"

#. OMI translation key: /citations/suffixPlaceholder
msgctxt "/citations/suffixPlaceholder"
msgid "e.g. emphasis added"
msgstr "pl. a kiemelés tőlem származik"

#. OMI translation key: /citations/openSource
msgctxt "/citations/openSource"
msgid "Open source"
msgstr "Nyílt forráskódú"

#. OMI translation key: /citations/closeEditor
msgctxt "/citations/closeEditor"
msgid "Close citation editor"
msgstr "Hivatkozásszerkesztő bezárása"

#. OMI translation key: /citations/deleteCitation
msgctxt "/citations/deleteCitation"
msgid "Delete citation"
msgstr "Hivatkozás törlése"

#. OMI translation key: /citations/confirmDeleteCitation
msgctxt "/citations/confirmDeleteCitation"
msgid "Delete this citation occurrence from the manuscript? The bibliographic record will remain in the reference library."
msgstr "Törölje ezt a hivatkozást a kéziratból? A bibliográfiai bejegyzés továbbra is a hivatkozási könyvtárban marad."

#. OMI translation key: /citations/unresolvedReference
msgctxt "/citations/unresolvedReference"
msgid "The cited bibliographic record is unresolved or missing."
msgstr "A hivatkozott bibliográfiai bejegyzés nem található, vagy hiányzik."

