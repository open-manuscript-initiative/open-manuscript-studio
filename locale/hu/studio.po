msgstr "Keresés az ORCID-ban…"

#. OMI translation key: /modules/orcidLookup/noResults
msgctxt "/modules/orcidLookup/noResults"
msgid "No matching public ORCID records found."
msgstr "Nem található egyező nyilvános ORCID-rekord."

#. OMI translation key: /modules/orcidLookup/unavailable
msgctxt "/modules/orcidLookup/unavailable"
msgid "ORCID search is temporarily unavailable. You can still enter an ORCID iD manually."
msgstr "Az ORCID-keresés átmenetileg nem érhető el. Az ORCID iD kézzel továbbra is megadható."

#. OMI translation key: /modules/orcidLookup/suggestions
msgctxt "/modules/orcidLookup/suggestions"
