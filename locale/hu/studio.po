msgctxt "/researchModules/transkribus/copy/statuses/RUNNING"
msgid "Recognising…"
msgstr "Felismerés…"

#. OMI translation key: /researchModules/transkribus/copy/statuses/FINISHED
msgctxt "/researchModules/transkribus/copy/statuses/FINISHED"
msgid "Finished"
msgstr "Befejeződött"

#. OMI translation key: /researchModules/transkribus/copy/statuses/FAILED
msgctxt "/researchModules/transkribus/copy/statuses/FAILED"
msgid "Recognition failed"
msgstr "Sikertelen felismerés"

#. OMI translation key: /researchModules/transkribus/copy/statuses/CANCELLED
msgctxt "/researchModules/transkribus/copy/statuses/CANCELLED"
msgid "Cancelled"
msgstr "Megszakítva"

#. OMI translation key: /researchModules/transkribus/copy/errors/TRANSKRIBUS_INVALID_LOGIN
msgctxt "/researchModules/transkribus/copy/errors/TRANSKRIBUS_INVALID_LOGIN"
msgid "Sign-in failed. Check your Transkribus credentials and API access."
msgstr "Sikertelen belépés. Ellenőrizd a Transkribus belépési adatait és az API-hozzáférést."

#. OMI translation key: /researchModules/transkribus/copy/errors/TRANSKRIBUS_RECONNECT
msgctxt "/researchModules/transkribus/copy/errors/TRANSKRIBUS_RECONNECT"
msgid "Reconnect your Transkribus account; the session is missing or expired."
msgstr "Csatlakoztasd újra a Transkribus-fiókot; a munkamenet hiányzik vagy lejárt."

#. OMI translation key: /researchModules/transkribus/copy/errors/TRANSKRIBUS_ACCESS_REQUIRED
msgctxt "/researchModules/transkribus/copy/errors/TRANSKRIBUS_ACCESS_REQUIRED"
msgid "Transkribus refused API access. Check the account plan and the server API configuration."
msgstr "A Transkribus megtagadta az API-hozzáférést. Ellenőrizd az előfizetést és a szerver API-beállítását."

#. OMI translation key: /researchModules/transkribus/copy/errors/TRANSKRIBUS_LIMIT
msgctxt "/researchModules/transkribus/copy/errors/TRANSKRIBUS_LIMIT"
msgid "Transkribus credits or request limits have been reached. Check your account before retrying."
msgstr "Elfogytak a Transkribus-kreditek, vagy elérted a lekérési korlátot. Újrapróbálás előtt ellenőrizd a fiókodat."

#. OMI translation key: /researchModules/transkribus/copy/errors/TRANSKRIBUS_NOT_FOUND
msgctxt "/researchModules/transkribus/copy/errors/TRANSKRIBUS_NOT_FOUND"
msgid "The model or result was not found. Choose another model; completed results may have expired."
msgstr "A modell vagy az eredmény nem található. Válassz másik modellt; a kész eredmény megőrzési ideje lejárhatott."

#. OMI translation key: /researchModules/transkribus/copy/errors/TRANSKRIBUS_INVALID_REQUEST
msgctxt "/researchModules/transkribus/copy/errors/TRANSKRIBUS_INVALID_REQUEST"
msgid "Check the selected model, image, transcription source and required approval."
msgstr "Ellenőrizd a kiválasztott modellt, az oldalképet, az átirat forrását és a szükséges jóváhagyást."

#. OMI translation key: /researchModules/transkribus/copy/errors/TRANSKRIBUS_INVALID_IMAGE
msgctxt "/researchModules/transkribus/copy/errors/TRANSKRIBUS_INVALID_IMAGE"
msgid "The file is not a supported page image or exceeds 20 MB."
msgstr "A fájl nem támogatott oldalkép, vagy nagyobb 20 MB-nál."

#. OMI translation key: /researchModules/transkribus/copy/errors/TRANSKRIBUS_INVALID_RESPONSE
msgctxt "/researchModules/transkribus/copy/errors/TRANSKRIBUS_INVALID_RESPONSE"
msgid "Transkribus returned an unexpected response. The existing manuscript was not changed."
msgstr "A Transkribus nem a várt választ küldte. A meglévő kézirat nem változott."

#. OMI translation key: /researchModules/transkribus/copy/errors/TRANSKRIBUS_RESULT_TOO_LARGE
msgctxt "/researchModules/transkribus/copy/errors/TRANSKRIBUS_RESULT_TOO_LARGE"
msgid "The recognition result exceeds the supported size."
msgstr "A felismerési eredmény meghaladja a támogatott méretet."

#. OMI translation key: /researchModules/transkribus/copy/errors/TRANSKRIBUS_INVALID_JOB
msgctxt "/researchModules/transkribus/copy/errors/TRANSKRIBUS_INVALID_JOB"
msgid "This recognition job is not available for the current Studio account."
msgstr "Ez a felismerési feladat a jelenlegi Stúdió-fiókhoz nem érhető el."

#. OMI translation key: /researchModules/transkribus/copy/errors/TRANSKRIBUS_UNAVAILABLE
msgctxt "/researchModules/transkribus/copy/errors/TRANSKRIBUS_UNAVAILABLE"
msgid "The Transkribus connection is temporarily unavailable. Try again later."
msgstr "A Transkribus-kapcsolat átmenetileg nem érhető el. Próbáld újra később."

#. OMI translation key: /researchModules/transkribus/copy/errors/TRANSKRIBUS_RATE_LIMIT
msgctxt "/researchModules/transkribus/copy/errors/TRANSKRIBUS_RATE_LIMIT"
msgid "Too many requests. Wait before trying again."
msgstr "Túl sok kérés. Várj az újrapróbálás előtt."

#. OMI translation key: /researchModules/transkribus/copy/errors/NOT_AUTHENTICATED
msgctxt "/researchModules/transkribus/copy/errors/NOT_AUTHENTICATED"
msgid "Sign in to Studio before connecting Transkribus."
msgstr "A Transkribus csatlakoztatásához jelentkezz be a Stúdióba."

#. OMI translation key: /researchModules/transkribus/copy/errors/MODULE_DISABLED_BY_INSTALLATION
msgctxt "/researchModules/transkribus/copy/errors/MODULE_DISABLED_BY_INSTALLATION"
msgid "The administrator has disabled the Critical text edition module."
msgstr "A rendszergazda letiltotta a Kritikai szövegkiadás modult."

#. OMI translation key: /researchModules/transkribus/copy/errors/MODULE_NOT_ACTIVE
msgctxt "/researchModules/transkribus/copy/errors/MODULE_NOT_ACTIVE"
msgid "Enable Critical text edition for this workspace in Settings."
msgstr "A Beállításoknál kapcsold be a Kritikai szövegkiadás modult ehhez a munkaterülethez."

#. OMI translation key: /researchModules/transkribus/copy/errors/RATE_LIMIT_EXCEEDED
msgctxt "/researchModules/transkribus/copy/errors/RATE_LIMIT_EXCEEDED"
msgid "Too many Studio API requests. Wait before trying again."
msgstr "Túl sok Stúdió API-kérés. Várj az újrapróbálás előtt."

#. OMI translation key: /researchModules/transkribus/copy/forget
msgctxt "/researchModules/transkribus/copy/forget"
msgid "Clear saved job on this device"
msgstr "Mentett feladat törlése ezen az eszközön"

#. OMI translation key: /researchModules/transkribus/copy/forgetConfirm
msgctxt "/researchModules/transkribus/copy/forgetConfirm"
msgid "Clear the saved job and transcription from this device? Download any needed text first. This does not cancel processing in Transkribus; an active job may continue using credits."
msgstr "Törlöd a mentett feladatot és átiratot erről az eszközről? Előbb töltsd le a szükséges szöveget. Ez nem szakítja meg a Transkribus feldolgozását; az aktív feladat továbbra is használhat kreditet."

#. OMI translation key: /researchModules/transkribus/copy/untitledSection
msgctxt "/researchModules/transkribus/copy/untitledSection"
msgid "Untitled section"
msgstr "Névtelen szakasz"

#. OMI translation key: /researchModules/transkribus/copy/model
msgctxt "/researchModules/transkribus/copy/model"
msgid "Recognition model"
msgstr "Felismerési modell"

#. OMI translation key: /researchModules/transkribus/copy/modelSearch
msgctxt "/researchModules/transkribus/copy/modelSearch"
msgid "Search models"
msgstr "Modellek keresése"

#. OMI translation key: /researchModules/transkribus/copy/modelLanguage
msgctxt "/researchModules/transkribus/copy/modelLanguage"
msgid "Model language"
msgstr "Modell nyelve"

#. OMI translation key: /researchModules/transkribus/copy/modelMaterial
msgctxt "/researchModules/transkribus/copy/modelMaterial"
msgid "Material"
msgstr "Anyagtípus"

#. OMI translation key: /researchModules/transkribus/copy/allLanguages
msgctxt "/researchModules/transkribus/copy/allLanguages"
msgid "All languages"
msgstr "Minden nyelv"

#. OMI translation key: /researchModules/transkribus/copy/allMaterials
msgctxt "/researchModules/transkribus/copy/allMaterials"
msgid "Handwriting and print"
msgstr "Kézírás és nyomtatott szöveg"

#. OMI translation key: /researchModules/transkribus/copy/handwritten
msgctxt "/researchModules/transkribus/copy/handwritten"
msgid "Handwritten"
msgstr "Kézírás"

#. OMI translation key: /researchModules/transkribus/copy/printed
msgctxt "/researchModules/transkribus/copy/printed"
msgid "Printed"
msgstr "Nyomtatott szöveg"

#. OMI translation key: /researchModules/transkribus/copy/chooseModel
msgctxt "/researchModules/transkribus/copy/chooseModel"
msgid "Choose a model…"
msgstr "Válassz modellt…"

#. OMI translation key: /researchModules/transkribus/copy/modelsHint
msgctxt "/researchModules/transkribus/copy/modelsHint"
msgid "Choose a public text recognition model by name. Studio fills in its ID automatically."
msgstr "Válassz név szerint a nyilvános szövegfelismerő modellek közül. Az azonosítót a Stúdió automatikusan kitölti."

#. OMI translation key: /researchModules/transkribus/copy/modelsLoading
msgctxt "/researchModules/transkribus/copy/modelsLoading"
msgid "Loading Transkribus models…"
msgstr "Transkribus-modellek betöltése…"

#. OMI translation key: /researchModules/transkribus/copy/modelsEmpty
msgctxt "/researchModules/transkribus/copy/modelsEmpty"
msgid "No models match these filters."
msgstr "Nincs a szűrésnek megfelelő modell."

#. OMI translation key: /researchModules/transkribus/copy/modelsRetry
msgctxt "/researchModules/transkribus/copy/modelsRetry"
msgid "Reload models"
msgstr "Modellek újratöltése"

#. OMI translation key: /researchModules/transkribus/copy/modelDetails
msgctxt "/researchModules/transkribus/copy/modelDetails"
msgid "Model details on Transkribus"
msgstr "Modelladatok a Transkribus oldalán"

#. OMI translation key: /researchModules/transkribus/copy/manualModel
msgctxt "/researchModules/transkribus/copy/manualModel"
msgid "Private model / enter an ID"
msgstr "Saját modell / azonosító megadása"

#. OMI translation key: /researchModules/transkribus/copy/manualModelHint
msgctxt "/researchModules/transkribus/copy/manualModelHint"
msgid "For a private model, enter its model ID from your Transkribus account. You can also enter a public model ID if the catalogue is unavailable."
msgstr "Saját modellhez add meg a Transkribus-fiókodban látható modellazonosítót. Ha a katalógus nem érhető el, nyilvános modell azonosítóját is megadhatod."

#. OMI translation key: /researchModules/transkribus/copy/selectedModel
msgctxt "/researchModules/transkribus/copy/selectedModel"
msgid "Selected model"
msgstr "Kiválasztott modell"

#. OMI translation key: /researchModules/transkribus/copy/modelMatches
msgctxt "/researchModules/transkribus/copy/modelMatches"
msgid "Matching models"
msgstr "Megfelelő modellek"

#. OMI translation key: /researchModules/transkribus/copy/modelCenturies
msgctxt "/researchModules/transkribus/copy/modelCenturies"
msgid "Centuries"
msgstr "Századok"

#. OMI translation key: /researchModules/transkribus/copy/errors/TRANSKRIBUS_MODELS_UNAVAILABLE
msgctxt "/researchModules/transkribus/copy/errors/TRANSKRIBUS_MODELS_UNAVAILABLE"
msgid "The public model catalogue could not be loaded. Try again or enter a model ID manually."
msgstr "A nyilvános modellkatalógus nem tölthető be. Próbáld újra, vagy add meg kézzel a modell azonosítóját."

#. OMI translation key: /uncataloguedUi/euroOfficeRecovery/title
msgctxt "/uncataloguedUi/euroOfficeRecovery/title"
msgid "Recovery saves"
msgstr "Helyreállítási mentések"

#. OMI translation key: /uncataloguedUi/euroOfficeRecovery/description
msgctxt "/uncataloguedUi/euroOfficeRecovery/description"
msgid "Force saves and conflicting callbacks are retained here. Final content is committed when the editor closes. Download a snapshot to recover it; this does not replace the current document."
msgstr "A részmentések és az ütköző visszahívások itt maradnak meg. A végleges dokumentum a szerkesztő bezárásakor frissül. A pillanatkép letöltése nem írja felül az aktuális dokumentumot."

#. OMI translation key: /uncataloguedUi/euroOfficeRecovery/loading
msgctxt "/uncataloguedUi/euroOfficeRecovery/loading"
msgid "Loading…"
msgstr "Betöltés…"

#. OMI translation key: /uncataloguedUi/euroOfficeRecovery/empty
msgctxt "/uncataloguedUi/euroOfficeRecovery/empty"
msgid "No saved snapshots."
msgstr "Még nincs mentett pillanatkép."

#. OMI translation key: /uncataloguedUi/euroOfficeRecovery/final
msgctxt "/uncataloguedUi/euroOfficeRecovery/final"
msgid "Final save"
msgstr "Végleges mentés"

#. OMI translation key: /uncataloguedUi/euroOfficeRecovery/previous
msgctxt "/uncataloguedUi/euroOfficeRecovery/previous"
msgid "Previous document"
msgstr "Korábbi dokumentum"

#. OMI translation key: /uncataloguedUi/euroOfficeRecovery/recovery
msgctxt "/uncataloguedUi/euroOfficeRecovery/recovery"
msgid "Recovery snapshot"
msgstr "Helyreállítási pillanatkép"

#. OMI translation key: /uncataloguedUi/euroOfficeRecovery/failed
msgctxt "/uncataloguedUi/euroOfficeRecovery/failed"
msgid "Recovery saves could not be loaded or downloaded."
msgstr "A helyreállítási mentések nem tölthetők be vagy le."

#. OMI translation key: /researchModules/history-archives-siusa-search-panel/copyByLocale/title
msgctxt "/researchModules/history-archives-siusa-search-panel/copyByLocale/title"
msgid "SIUSA — Italian archival descriptions"
msgstr "SIUSA – olasz levéltári kereső"

#. OMI translation key: /researchModules/history-archives-siusa-search-panel/copyByLocale/description
msgctxt "/researchModules/history-archives-siusa-search-panel/copyByLocale/description"
msgid "Search SIUSA, the Italian national information system for non-state archives. Results open in the official catalogue in a new tab."
msgstr "Keresés a SIUSA-ban, az olasz nem állami levéltárak országos információs rendszerében. Az eredmények a hivatalos katalógusban nyílnak meg új lapon."

#. OMI translation key: /researchModules/history-archives-siusa-search-panel/copyByLocale/label
msgctxt "/researchModules/history-archives-siusa-search-panel/copyByLocale/label"
msgid "Search SIUSA archives"
msgstr "Keresés a SIUSA levéltári adatbázisában"

#. OMI translation key: /researchModules/history-archives-siusa-search-panel/copyByLocale/placeholder
msgctxt "/researchModules/history-archives-siusa-search-panel/copyByLocale/placeholder"
msgid "Name, archive, place, or keyword"
msgstr "Név, levéltár, hely vagy kulcsszó"

#. OMI translation key: /researchModules/history-archives-siusa-search-panel/copyByLocale/search
msgctxt "/researchModules/history-archives-siusa-search-panel/copyByLocale/search"
msgid "Search SIUSA"
msgstr "Keresés a SIUSA-ban"
