msgstr "JATS diagnosztika"

#. OMI translation key: /modules/jatsExport/noDiagnostics
msgctxt "/modules/jatsExport/noDiagnostics"
msgid "No JATS-specific diagnostics."
msgstr "Nincs JATS-specifikus diagnosztika."

#. OMI translation key: /modules/jatsExport/workingPreview
msgctxt "/modules/jatsExport/workingPreview"
msgid "The preview reflects the current working state. Download creates a checkpoint first so the exported XML is traceable to a committed revision."
msgstr "Az előnézet az aktuális munkapéldányt mutatja. Letöltéskor a Studio előbb checkpointot készít, így az XML egy konkrét committed revízióhoz visszavezethető."

#. OMI translation key: /modules/jatsExport/unsupportedProfile
msgctxt "/modules/jatsExport/unsupportedProfile"
msgid "The active profile does not declare JATS as a supported output."
msgstr "Az aktív profil nem jelöli támogatott kimenetként a JATS formátumot."

#. OMI translation key: /modules/jatsExport/schemaNote
msgctxt "/modules/jatsExport/schemaNote"
msgid "Studio checks required structure, XML identifiers and internal rid targets. Full external JATS DTD/XSD/RNG validation remains a separate conformance step."
msgstr "A Studio ellenőrzi a kötelező szerkezetet, az XML-azonosítókat és a belső rid célokat. A teljes külső JATS DTD/XSD/RNG validáció külön megfelelőségi lépés marad."

#. OMI translation key: /modules/noteCitations/addCitation
msgctxt "/modules/noteCitations/addCitation"
msgid "Insert reference"
msgstr "Hivatkozás beszúrása"

#. OMI translation key: /modules/noteCitations/citations
msgctxt "/modules/noteCitations/citations"
msgid "References in this note"
msgstr "A jegyzet hivatkozásai"

#. OMI translation key: /modules/noteCitations/noCitations
msgctxt "/modules/noteCitations/noCitations"
msgid "No bibliographic references have been added to this note yet."
msgstr "Ehhez a jegyzethez még nincs bibliográfiai hivatkozás."

#. OMI translation key: /modules/noteCitations/removeCitation
msgctxt "/modules/noteCitations/removeCitation"
msgid "Remove reference"
msgstr "Hivatkozás eltávolítása"

#. OMI translation key: /modules/noteCitations/citationHint
msgctxt "/modules/noteCitations/citationHint"
msgid "Choose from the manuscript bibliography. Page, chapter, section and other locators are supported."
msgstr "Válasszon a kézirat hivatkozásjegyzékéből. Oldal-, fejezet-, szakasz- és más helymegjelölés is megadható."

#. OMI translation key: /modules/orcidLookup/searching
