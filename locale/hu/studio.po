#. OMI translation key: /studio/tools/title
msgctxt "/studio/tools/title"
msgid "Export and tools"
msgstr "Export és eszközök"

#. OMI translation key: /studio/tools/description
msgctxt "/studio/tools/description"
msgid "Secondary, technical and potentially destructive actions are kept outside the writing surface."
msgstr "A másodlagos, technikai és esetleg romboló műveletek nem jelennek meg a szerkesztési felületen."

