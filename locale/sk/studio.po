msgstr "Synchronizované"

#. OMI translation key: /studio/settings/title
msgctxt "/studio/settings/title"
msgid "Interface settings"
msgstr "Nastavenia rozhrania"

#. OMI translation key: /studio/settings/description
msgctxt "/studio/settings/description"
msgid "Choose which interface languages you want available while working. These preferences are stored on this device."
msgstr "Vyberte si, ktoré jazyky rozhrania chcete mať k dispozícii počas práce. Tieto nastavenia sa ukladajú v tomto zariadení."

#. OMI translation key: /studio/settings/interfaceLanguages
msgctxt "/studio/settings/interfaceLanguages"
msgid "Available interface languages"
msgstr "Dostupné jazyky rozhrania"

#. OMI translation key: /studio/settings/interfaceLanguagesDescription
msgctxt "/studio/settings/interfaceLanguagesDescription"
msgid "Enabled languages appear in the quick language switcher in the editor header."
msgstr "Aktivované jazyky sa zobrazujú v rýchlom prepínači jazykov v hlavičke editora."

#. OMI translation key: /studio/settings/currentLanguage
msgctxt "/studio/settings/currentLanguage"
msgid "Current interface language"
msgstr "Aktuálny jazyk rozhrania"

#. OMI translation key: /studio/settings/currentLanguageHint
msgctxt "/studio/settings/currentLanguageHint"
msgid "The language currently in use must remain enabled. Switch to another language before disabling it."
msgstr "Aktuálne nastavený jazyk musí zostať povolený. Pred jeho deaktiváciou prejdite na iný jazyk."

#. OMI translation key: /studio/settings/enabledLanguage
msgctxt "/studio/settings/enabledLanguage"
msgid "Available in quick switcher"
msgstr "K dispozícii v rýchlom prepínači"

#. OMI translation key: /studio/settings/disabledLanguage
msgctxt "/studio/settings/disabledLanguage"
msgid "Hidden from quick switcher"
msgstr "Skryté pred rýchlym prepínačom"

#. OMI translation key: /studio/settings/futureLanguages
msgctxt "/studio/settings/futureLanguages"
msgid "The language registry is extensible. Future translation dictionaries can be added without redesigning this settings screen."
msgstr "Register jazykov je rozširovateľný. Budúce prekladové slovníky bude možné pridať bez nutnosti prepracovania tejto obrazovky nastavení."

