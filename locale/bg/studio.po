#. OMI translation key: /modules/help/navigation
msgctxt "/modules/help/navigation"
msgid "Help"
msgstr "Помощ"

#. OMI translation key: /modules/help/title
msgctxt "/modules/help/title"
msgid "Help for authors"
msgstr "Помощ за автори"

#. OMI translation key: /modules/help/description
msgctxt "/modules/help/description"
msgid "A short guide to editing manuscripts and using the main Studio features."
msgstr "Кратко ръководство за редактиране на ръкописи и използване на основните функции на Studio."

#. OMI translation key: /modules/help/gettingStarted
msgctxt "/modules/help/gettingStarted"
msgid "When a manuscript is opened from OJS, Studio imports the document and available publication metadata. Editing then takes place in the Studio manuscript model."
msgstr "Когато ръкопис се отвори от OJS, Studio импортира документа и наличните публикационни метаданни. След това редактирането се извършва в модела на ръкописа на Studio."

#. OMI translation key: /modules/help/topics/0/title
msgctxt "/modules/help/topics/0/title"
msgid "Editing the manuscript"
msgstr "Редактиране на ръкописа"

#. OMI translation key: /modules/help/topics/0/body
msgctxt "/modules/help/topics/0/body"
msgid "Edit manuscript text in the main editor. Review its structure under Manuscript menu → Document."
msgstr "Редактирайте текста на ръкописа в основния редактор. Проверете структурата му в Меню на ръкописа → Документ."

#. OMI translation key: /modules/help/topics/0/tips/0
msgctxt "/modules/help/topics/0/tips/0"
msgid "Use real heading styles for section headings."
msgstr "Използвайте истински стилове за заглавията на разделите."

#. OMI translation key: /modules/help/topics/0/tips/1
msgctxt "/modules/help/topics/0/tips/1"
msgid "Do not rely on bold text or font size alone to express structure."
msgstr "Не разчитайте само на удебелен текст или размер на шрифта за обозначаване на структура."

#. OMI translation key: /modules/help/topics/1/title
msgctxt "/modules/help/topics/1/title"
msgid "Manuscript data and languages"
msgstr "Данни за ръкописа и езици"

#. OMI translation key: /modules/help/topics/1/body
msgctxt "/modules/help/topics/1/body"
msgid "Abstracts, keywords and other scholarly metadata are edited under Manuscript data. Multilingual fields can be maintained separately in HU, EN and DE."
msgstr "Резюметата, ключовите думи и другите научни метаданни се редактират в Данни за ръкописа. Многоезичните полета могат да се поддържат отделно на HU, EN и DE."

#. OMI translation key: /modules/help/topics/1/tips/0
msgctxt "/modules/help/topics/1/tips/0"
msgid "The manuscript language and metadata language are separate concepts."
msgstr "Езикът на ръкописа и езикът на метаданните са различни понятия."

#. OMI translation key: /modules/help/topics/1/tips/1
msgctxt "/modules/help/topics/1/tips/1"
msgid "A Hungarian article may also have English and German abstracts and keywords."
msgstr "Унгарска статия може да има и английски и немски резюмета и ключови думи."

#. OMI translation key: /modules/help/topics/2/title
msgctxt "/modules/help/topics/2/title"
msgid "Notes"
msgstr "Бележки"

#. OMI translation key: /modules/help/topics/2/body
msgctxt "/modules/help/topics/2/body"
msgid "Footnotes and endnotes are retained as semantic note objects. Review and edit them under Notes."
msgstr "Бележките под линия и крайните бележки се запазват като семантични обекти за бележки. Преглеждайте и редактирайте ги в Бележки."

#. OMI translation key: /modules/help/topics/3/title
msgctxt "/modules/help/topics/3/title"
msgid "References"
msgstr "Източници"

#. OMI translation key: /modules/help/topics/3/body
msgctxt "/modules/help/topics/3/body"
msgid "Cited works are stored as structured bibliographic records. Add a work once and reuse it in multiple citations."
msgstr "Цитираните произведения се съхраняват като структурирани библиографски записи. Добавете произведение веднъж и го използвайте повторно в множество цитирания."

#. OMI translation key: /modules/help/topics/4/title
msgctxt "/modules/help/topics/4/title"
msgid "Contributors"
msgstr "Сътрудници"

#. OMI translation key: /modules/help/topics/4/body
msgctxt "/modules/help/topics/4/body"
msgid "Manage authors and other contributors, roles, affiliations and ORCID identifiers here."
msgstr "Тук управлявайте автори и други сътрудници, роли, институционални принадлежности и ORCID идентификатори."

#. OMI translation key: /modules/help/topics/5/title
msgctxt "/modules/help/topics/5/title"
msgid "Revisions and saving"
msgstr "Ревизии и записване"

#. OMI translation key: /modules/help/topics/5/body
msgctxt "/modules/help/topics/5/body"
msgid "Studio tracks important changes as revisions. Use History to review changes and, where supported, return to an earlier state."
msgstr "Studio проследява важните промени като ревизии. Използвайте История, за да преглеждате промените и, когато е възможно, да се връщате към по-ранно състояние."

#. OMI translation key: /modules/help/topics/6/title
msgctxt "/modules/help/topics/6/title"
msgid "Import from OJS"
msgstr "Импорт от OJS"

#. OMI translation key: /modules/help/topics/6/body
msgctxt "/modules/help/topics/6/body"
msgid "Studio can import the document, abstracts, keywords and other publication metadata from OJS. Only metadata actually present in OJS can be imported."
msgstr "Studio може да импортира документа, резюмета, ключови думи и други публикационни метаданни от OJS. Могат да се импортират само метаданни, които действително присъстват в OJS."

#. OMI translation key: /modules/help/topics/7/title
msgctxt "/modules/help/topics/7/title"
msgid "DOCX import"
msgstr "DOCX импорт"

#. OMI translation key: /modules/help/topics/7/body
msgctxt "/modules/help/topics/7/body"
msgid "When importing Word documents, Studio also attempts to recover document structure."
msgstr "При импортиране на Word документи Studio се опитва да възстанови и структурата на документа."

#. OMI translation key: /modules/help/topics/7/tips/0
msgctxt "/modules/help/topics/7/tips/0"
msgid "Use Word Heading 1, Heading 2, etc. for section headings."
msgstr "Използвайте Word Heading 1, Heading 2 и т.н. за заглавията на разделите."

#. OMI translation key: /modules/help/topics/7/tips/1
msgctxt "/modules/help/topics/7/tips/1"
msgid "Direct-formatting recognition is only a fallback."
msgstr "Разпознаването на директно форматиране е само резервен метод."

#. OMI translation key: /modules/help/topics/8/title
msgctxt "/modules/help/topics/8/title"
msgid "Export"
msgstr "Експорт"

#. OMI translation key: /modules/help/topics/8/body
msgctxt "/modules/help/topics/8/body"
msgid "Export & tools can create a portable .omi.json manuscript file containing the semantic document structure and OMI metadata."
msgstr "Експорт и инструменти може да създаде преносим .omi.json файл на ръкописа със семантичната структура на документа и OMI метаданните."

#. OMI translation key: /modules/help/topics/9/title
msgctxt "/modules/help/topics/9/title"
msgid "If something looks wrong"
msgstr "Ако нещо изглежда неправилно"

#. OMI translation key: /modules/help/topics/9/body
msgctxt "/modules/help/topics/9/body"
msgid "Check the manuscript language, selected metadata language and, for Word imports, heading styles. For OJS imports, also verify that the value is actually filled in under the OJS Publication metadata."
msgstr "Проверете езика на ръкописа, избрания език на метаданните и при Word импорт — стиловете за заглавия. При OJS импорт проверете също дали стойността действително е попълнена в публикационните метаданни на OJS."

#. OMI translation key: /modules/htmlExport/title
msgctxt "/modules/htmlExport/title"
msgid "Semantic HTML5"
msgstr "Семантичен HTML5"

#. OMI translation key: /modules/htmlExport/description
msgctxt "/modules/htmlExport/description"
msgid "Render the semantic manuscript through the active Publication Profile as an accessible, script-free HTML5 scholarly article."
msgstr "Визуализирайте семантичния ръкопис чрез активния профил за публикуване като достъпна научна статия HTML5 без скриптове."

#. OMI translation key: /modules/htmlExport/standard
msgctxt "/modules/htmlExport/standard"
msgid "Output profile"
msgstr "Изходен профил"

#. OMI translation key: /modules/htmlExport/renderingContext
msgctxt "/modules/htmlExport/renderingContext"
msgid "Rendering context"
msgstr "Контекст на визуализацията"

#. OMI translation key: /modules/htmlExport/currentRevision
msgctxt "/modules/htmlExport/currentRevision"
msgid "Manuscript revision"
msgstr "Ревизия на ръкописа"

#. OMI translation key: /modules/htmlExport/preview
msgctxt "/modules/htmlExport/preview"
msgid "Preview source"
msgstr "Преглед на изходния код"

#. OMI translation key: /modules/htmlExport/hidePreview
msgctxt "/modules/htmlExport/hidePreview"
msgid "Hide source"
msgstr "Скриване на изходния код"

#. OMI translation key: /modules/htmlExport/openPreview
msgctxt "/modules/htmlExport/openPreview"
msgid "Open rendered preview"
msgstr "Отваряне на визуализирания преглед"

#. OMI translation key: /modules/htmlExport/downloadPackage
msgctxt "/modules/htmlExport/downloadPackage"
msgid "Download HTML package"
msgstr "Изтегляне на HTML пакет"

#. OMI translation key: /modules/htmlExport/preparingPackage
msgctxt "/modules/htmlExport/preparingPackage"
msgid "Preparing package…"
msgstr "Подготовка на пакета…"

#. OMI translation key: /modules/htmlExport/exportReady
msgctxt "/modules/htmlExport/exportReady"
msgid "The HTML rendering has no blocking diagnostics."
msgstr "HTML визуализацията няма блокираща диагностика."

#. OMI translation key: /modules/htmlExport/exportHasErrors
msgctxt "/modules/htmlExport/exportHasErrors"
msgid "The HTML can be inspected, but blocking diagnostics must be resolved before a publication package is created."
msgstr "HTML може да бъде прегледан, но блокиращата диагностика трябва да бъде отстранена преди създаването на публикационен пакет."

#. OMI translation key: /modules/htmlExport/errors
msgctxt "/modules/htmlExport/errors"
msgid "errors"
msgstr "грешки"

#. OMI translation key: /modules/htmlExport/warnings
msgctxt "/modules/htmlExport/warnings"
msgid "warnings"
msgstr "предупреждения"

#. OMI translation key: /modules/htmlExport/diagnostics
msgctxt "/modules/htmlExport/diagnostics"
msgid "HTML diagnostics"
msgstr "HTML диагностика"

#. OMI translation key: /modules/htmlExport/noDiagnostics
msgctxt "/modules/htmlExport/noDiagnostics"
msgid "No HTML-specific diagnostics."
msgstr "Няма специфична за HTML диагностика."

#. OMI translation key: /modules/htmlExport/workingPreview
msgctxt "/modules/htmlExport/workingPreview"
msgid "The preview reflects the current working state. Package download creates a checkpoint first so the output is traceable to a committed revision."
msgstr "Прегледът отразява текущото работно състояние. Изтеглянето на пакета първо създава контролна точка, за да може изходът да бъде проследен до записана ревизия."

#. OMI translation key: /modules/htmlExport/unsupportedProfile
msgctxt "/modules/htmlExport/unsupportedProfile"
msgid "The active profile does not declare HTML as a supported output."
msgstr "Активният профил не посочва HTML като поддържан изход."

#. OMI translation key: /modules/htmlExport/accessibilityNote
msgctxt "/modules/htmlExport/accessibilityNote"
msgid "The renderer uses semantic headings, figures, tables, document-note roles, bibliography links and explicit image alt attributes. External accessibility auditing remains a separate publication step."
msgstr "Визуализаторът използва семантични заглавия, фигури, таблици, роли за бележки в документа, библиографски връзки и явни alt атрибути за изображения. Външният одит за достъпност остава отделна стъпка при публикуването."

#. OMI translation key: /modules/htmlExport/packageNote
msgctxt "/modules/htmlExport/packageNote"
msgid "The ZIP package contains index.html, a manifest and referenced media assets under relative media/ paths. No script or external stylesheet is required."
msgstr "ZIP пакетът съдържа index.html, манифест и използваните медийни ресурси в относителни пътища media/. Не са необходими скриптове или външни стилови таблици."

#. OMI translation key: /modules/jatsExport/title
msgctxt "/modules/jatsExport/title"
msgid "JATS XML"
msgstr "JATS XML"

#. OMI translation key: /modules/jatsExport/description
msgctxt "/modules/jatsExport/description"
msgid "Render the semantic manuscript through the active Publication Profile as NISO JATS 1.4 Article Authoring XML."
msgstr "Визуализирайте семантичния ръкопис чрез активния профил за публикуване като NISO JATS 1.4 Article Authoring XML."

#. OMI translation key: /modules/jatsExport/standard
msgctxt "/modules/jatsExport/standard"
msgid "Target standard"
msgstr "Целеви стандарт"

#. OMI translation key: /modules/jatsExport/renderingContext
msgctxt "/modules/jatsExport/renderingContext"
msgid "Rendering context"
msgstr "Контекст на визуализацията"

#. OMI translation key: /modules/jatsExport/currentRevision
msgctxt "/modules/jatsExport/currentRevision"
msgid "Manuscript revision"
msgstr "Ревизия на ръкописа"

#. OMI translation key: /modules/jatsExport/preview
msgctxt "/modules/jatsExport/preview"
msgid "Preview XML"
msgstr "Преглед на XML"

#. OMI translation key: /modules/jatsExport/hidePreview
msgctxt "/modules/jatsExport/hidePreview"
msgid "Hide XML"
msgstr "Скриване на XML"

#. OMI translation key: /modules/jatsExport/download
msgctxt "/modules/jatsExport/download"
msgid "Download JATS XML"
msgstr "Изтегляне на JATS XML"

#. OMI translation key: /modules/jatsExport/exportReady
msgctxt "/modules/jatsExport/exportReady"
msgid "The JATS rendering has no blocking diagnostics."
msgstr "JATS визуализацията няма блокираща диагностика."

#. OMI translation key: /modules/jatsExport/exportHasErrors
msgctxt "/modules/jatsExport/exportHasErrors"
msgid "The XML can be inspected, but blocking diagnostics must be resolved before publication."
msgstr "XML може да бъде прегледан, но блокиращата диагностика трябва да бъде отстранена преди публикуване."

#. OMI translation key: /modules/jatsExport/errors
msgctxt "/modules/jatsExport/errors"
msgid "errors"
msgstr "грешки"

#. OMI translation key: /modules/jatsExport/warnings
msgctxt "/modules/jatsExport/warnings"
msgid "warnings"
msgstr "предупреждения"

#. OMI translation key: /modules/jatsExport/diagnostics
msgctxt "/modules/jatsExport/diagnostics"
msgid "JATS diagnostics"
msgstr "JATS диагностика"

#. OMI translation key: /modules/jatsExport/noDiagnostics
msgctxt "/modules/jatsExport/noDiagnostics"
