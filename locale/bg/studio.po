msgid "Locator type"
msgstr "Тип локатор"

#. OMI translation key: /citations/locator
msgctxt "/citations/locator"
msgid "Locator"
msgstr "Локатор"

#. OMI translation key: /citations/locatorPlaceholder
msgctxt "/citations/locatorPlaceholder"
msgid "e.g. 45–47, 12r–13v, chapter 4"
msgstr "напр. 45–47, 12r–13v, глава 4"

#. OMI translation key: /citations/prefix
msgctxt "/citations/prefix"
msgid "Prefix"
msgstr "Префикс"

#. OMI translation key: /citations/prefixPlaceholder
msgctxt "/citations/prefixPlaceholder"
msgid "e.g. see also"
msgstr "напр. виж също"

#. OMI translation key: /citations/suffix
msgctxt "/citations/suffix"
msgid "Suffix"
msgstr "Суфикс"

#. OMI translation key: /citations/suffixPlaceholder
msgctxt "/citations/suffixPlaceholder"
msgid "e.g. emphasis added"
msgstr "напр. курсивът е добавен"

#. OMI translation key: /citations/openSource
