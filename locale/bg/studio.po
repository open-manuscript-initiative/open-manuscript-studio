msgctxt "/citations/confirmDeleteCitation"
msgid "Delete this citation occurrence from the manuscript? The bibliographic record will remain in the reference library."
msgstr "Да се изтрие ли това конкретно цитиране от ръкописа? Библиографският запис ще остане в библиотеката."

#. OMI translation key: /citations/unresolvedReference
msgctxt "/citations/unresolvedReference"
msgid "The cited bibliographic record is unresolved or missing."
msgstr "Цитираният библиографски запис не може да бъде разрешен или липсва."

