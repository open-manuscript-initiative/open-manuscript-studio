msgstr "Място на издаване"

#. OMI translation key: /citations/duplicateReference
msgctxt "/citations/duplicateReference"
msgid "A likely duplicate already exists in the reference library:"
msgstr "Вероятен дубликат вече съществува в библиотеката с източници:"

#. OMI translation key: /citations/insertTitle
msgctxt "/citations/insertTitle"
msgid "Insert citation"
msgstr "Вмъкване на цитиране"

#. OMI translation key: /citations/insertDescription
msgctxt "/citations/insertDescription"
msgid "Choose a work from the manuscript reference library and optionally specify the cited location."
msgstr "Изберете труд от библиотеката с източници и по желание посочете конкретното цитирано място."

#. OMI translation key: /citations/noReferences
msgctxt "/citations/noReferences"
msgid "No reference is available yet."
msgstr "Все още няма наличен източник."

#. OMI translation key: /citations/noReferencesHint
msgctxt "/citations/noReferencesHint"
msgid "Add the work from Manuscript menu → References, then return here to cite it."
msgstr "Добавете труда чрез Меню на ръкописа → Източници и след това се върнете тук, за да го цитирате."

#. OMI translation key: /citations/insert
msgctxt "/citations/insert"
msgid "Insert citation"
msgstr "Вмъкване на цитиране"

#. OMI translation key: /citations/citation
msgctxt "/citations/citation"
