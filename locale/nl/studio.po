msgid "The translation has not yet been fully reviewed."
msgstr "De vertaling is nog niet volledig gecontroleerd."

msgctxt "/uncataloguedUi/validationModel/message-invalid-portable-document"
msgid "The manuscript does not satisfy the portable OMI format checks."
msgstr "Het manuscript voldoet niet aan de controles voor het draagbare OMI-formaat."

msgctxt "/uncataloguedUi/validationModel/message-asset-check-unavailable"
msgid "Local asset bytes could not be inspected."
msgstr "De gegevens van lokale bijlagen konden niet worden onderzocht."

msgctxt "/uncataloguedUi/validationModel/message-missing-asset"
msgid "A declared asset has no local payload."
msgstr "Een opgegeven bijlage heeft geen lokale gegevens."

msgctxt "/uncataloguedUi/validationModel/message-invalid-asset"
msgid "Asset size or checksum does not match the local bytes."
msgstr "De grootte of het controlegetal van de bijlage komt niet overeen met de lokale gegevens."

msgctxt "/uncataloguedUi/validationModel/message-check-unavailable"
msgid "This check could not run; the result is incomplete."
msgstr "Deze controle kon niet worden uitgevoerd; het resultaat is onvolledig."
