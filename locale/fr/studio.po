#. OMI translation key: /researchModules/transkribus/copy/errors/TRANSKRIBUS_INVALID_LOGIN
msgctxt "/researchModules/transkribus/copy/errors/TRANSKRIBUS_INVALID_LOGIN"
msgid "Sign-in failed. Check your Transkribus credentials and API access."
msgstr "Échec de connexion. Vérifiez vos identifiants Transkribus et votre accès à l’API."

#. OMI translation key: /researchModules/transkribus/copy/errors/TRANSKRIBUS_RECONNECT
msgctxt "/researchModules/transkribus/copy/errors/TRANSKRIBUS_RECONNECT"
msgid "Reconnect your Transkribus account; the session is missing or expired."
msgstr "Reconnectez votre compte Transkribus ; la session est absente ou a expiré."

#. OMI translation key: /researchModules/transkribus/copy/errors/TRANSKRIBUS_ACCESS_REQUIRED
msgctxt "/researchModules/transkribus/copy/errors/TRANSKRIBUS_ACCESS_REQUIRED"
msgid "Transkribus refused API access. Check the account plan and the server API configuration."
msgstr "Transkribus a refusé l’accès à l’API. Vérifiez l’offre du compte et la configuration de l’API sur le serveur."

#. OMI translation key: /researchModules/transkribus/copy/errors/TRANSKRIBUS_LIMIT
msgctxt "/researchModules/transkribus/copy/errors/TRANSKRIBUS_LIMIT"
msgid "Transkribus credits or request limits have been reached. Check your account before retrying."
msgstr "Les crédits Transkribus ou les limites de requêtes sont atteints. Vérifiez votre compte avant de réessayer."

#. OMI translation key: /researchModules/transkribus/copy/errors/TRANSKRIBUS_NOT_FOUND
msgctxt "/researchModules/transkribus/copy/errors/TRANSKRIBUS_NOT_FOUND"
msgid "The model or result was not found. Choose another model; completed results may have expired."
msgstr "Modèle ou résultat introuvable. Choisissez un autre modèle ; les résultats terminés ont peut-être expiré."

#. OMI translation key: /researchModules/transkribus/copy/errors/TRANSKRIBUS_INVALID_REQUEST
msgctxt "/researchModules/transkribus/copy/errors/TRANSKRIBUS_INVALID_REQUEST"
msgid "Check the selected model, image, transcription source and required approval."
msgstr "Vérifiez le modèle sélectionné, l’image, la source de transcription et l’autorisation requise."

#. OMI translation key: /researchModules/transkribus/copy/errors/TRANSKRIBUS_INVALID_IMAGE
msgctxt "/researchModules/transkribus/copy/errors/TRANSKRIBUS_INVALID_IMAGE"
msgid "The file is not a supported page image or exceeds 20 MB."
msgstr "Le fichier n’est pas une image de page prise en charge ou dépasse 20 Mo."

#. OMI translation key: /researchModules/transkribus/copy/errors/TRANSKRIBUS_INVALID_RESPONSE
msgctxt "/researchModules/transkribus/copy/errors/TRANSKRIBUS_INVALID_RESPONSE"
msgid "Transkribus returned an unexpected response. The existing manuscript was not changed."
msgstr "Transkribus a renvoyé une réponse inattendue. Le manuscrit existant n’a pas été modifié."

#. OMI translation key: /researchModules/transkribus/copy/errors/TRANSKRIBUS_RESULT_TOO_LARGE
msgctxt "/researchModules/transkribus/copy/errors/TRANSKRIBUS_RESULT_TOO_LARGE"
msgid "The recognition result exceeds the supported size."
msgstr "Le résultat de reconnaissance dépasse la taille prise en charge."

#. OMI translation key: /researchModules/transkribus/copy/errors/TRANSKRIBUS_INVALID_JOB
msgctxt "/researchModules/transkribus/copy/errors/TRANSKRIBUS_INVALID_JOB"
msgid "This recognition job is not available for the current Studio account."
msgstr "Cette tâche de reconnaissance n’est pas disponible pour le compte Studio actuel."

#. OMI translation key: /researchModules/transkribus/copy/errors/TRANSKRIBUS_UNAVAILABLE
msgctxt "/researchModules/transkribus/copy/errors/TRANSKRIBUS_UNAVAILABLE"
msgid "The Transkribus connection is temporarily unavailable. Try again later."
msgstr "La connexion à Transkribus est temporairement indisponible. Réessayez plus tard."

#. OMI translation key: /researchModules/transkribus/copy/errors/TRANSKRIBUS_RATE_LIMIT
msgctxt "/researchModules/transkribus/copy/errors/TRANSKRIBUS_RATE_LIMIT"
msgid "Too many requests. Wait before trying again."
msgstr "Trop de requêtes. Attendez avant de réessayer."

#. OMI translation key: /researchModules/transkribus/copy/errors/NOT_AUTHENTICATED
msgctxt "/researchModules/transkribus/copy/errors/NOT_AUTHENTICATED"
msgid "Sign in to Studio before connecting Transkribus."
msgstr "Connectez-vous à Studio avant de connecter Transkribus."

#. OMI translation key: /researchModules/transkribus/copy/errors/MODULE_DISABLED_BY_INSTALLATION
msgctxt "/researchModules/transkribus/copy/errors/MODULE_DISABLED_BY_INSTALLATION"
msgid "The administrator has disabled the Critical text edition module."
msgstr "L’administrateur a désactivé le module Édition critique."

#. OMI translation key: /researchModules/transkribus/copy/errors/MODULE_NOT_ACTIVE
msgctxt "/researchModules/transkribus/copy/errors/MODULE_NOT_ACTIVE"
msgid "Enable Critical text edition for this workspace in Settings."
msgstr "Activez Édition critique pour cet espace de travail dans Paramètres."

#. OMI translation key: /researchModules/transkribus/copy/errors/RATE_LIMIT_EXCEEDED
msgctxt "/researchModules/transkribus/copy/errors/RATE_LIMIT_EXCEEDED"
msgid "Too many Studio API requests. Wait before trying again."
msgstr "Trop de requêtes API Studio. Attendez avant de réessayer."

#. OMI translation key: /researchModules/transkribus/copy/forget
msgctxt "/researchModules/transkribus/copy/forget"
msgid "Clear saved job on this device"
msgstr "Effacer la tâche enregistrée sur cet appareil"

#. OMI translation key: /researchModules/transkribus/copy/forgetConfirm
msgctxt "/researchModules/transkribus/copy/forgetConfirm"
msgid "Clear the saved job and transcription from this device? Download any needed text first. This does not cancel processing in Transkribus; an active job may continue using credits."
msgstr "Effacer la tâche enregistrée et la transcription de cet appareil ? Téléchargez d’abord tout texte nécessaire. Cela n’annule pas le traitement dans Transkribus ; une tâche active peut continuer à consommer des crédits."

#. OMI translation key: /researchModules/transkribus/copy/untitledSection
msgctxt "/researchModules/transkribus/copy/untitledSection"
msgid "Untitled section"
msgstr "Section sans titre"

