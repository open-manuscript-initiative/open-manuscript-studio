msgstr "Imprimée"

#. OMI translation key: /researchModules/transkribus/copy/chooseModel
msgctxt "/researchModules/transkribus/copy/chooseModel"
msgid "Choose a model…"
msgstr "Choisir un modèle…"

#. OMI translation key: /researchModules/transkribus/copy/modelsHint
msgctxt "/researchModules/transkribus/copy/modelsHint"
msgid "Choose a public text recognition model by name. Studio fills in its ID automatically."
msgstr "Choisissez par son nom un modèle public de reconnaissance de texte. Studio renseigne automatiquement son identifiant."

#. OMI translation key: /researchModules/transkribus/copy/modelsLoading
msgctxt "/researchModules/transkribus/copy/modelsLoading"
msgid "Loading Transkribus models…"
msgstr "Chargement des modèles Transkribus…"

#. OMI translation key: /researchModules/transkribus/copy/modelsEmpty
msgctxt "/researchModules/transkribus/copy/modelsEmpty"
msgid "No models match these filters."
msgstr "Aucun modèle ne correspond à ces filtres."

#. OMI translation key: /researchModules/transkribus/copy/modelsRetry
msgctxt "/researchModules/transkribus/copy/modelsRetry"
msgid "Reload models"
msgstr "Recharger les modèles"

#. OMI translation key: /researchModules/transkribus/copy/modelDetails
msgctxt "/researchModules/transkribus/copy/modelDetails"
msgid "Model details on Transkribus"
msgstr "Détails du modèle sur Transkribus"

#. OMI translation key: /researchModules/transkribus/copy/manualModel
msgctxt "/researchModules/transkribus/copy/manualModel"
msgid "Private model / enter an ID"
msgstr "Modèle privé / saisir un identifiant"

#. OMI translation key: /researchModules/transkribus/copy/manualModelHint
msgctxt "/researchModules/transkribus/copy/manualModelHint"
msgid "For a private model, enter its model ID from your Transkribus account. You can also enter a public model ID if the catalogue is unavailable."
msgstr "Pour un modèle privé, saisissez son identifiant depuis votre compte Transkribus. Vous pouvez aussi saisir l’identifiant d’un modèle public si le catalogue est indisponible."

#. OMI translation key: /researchModules/transkribus/copy/selectedModel
msgctxt "/researchModules/transkribus/copy/selectedModel"
msgid "Selected model"
msgstr "Modèle sélectionné"

#. OMI translation key: /researchModules/transkribus/copy/modelMatches
msgctxt "/researchModules/transkribus/copy/modelMatches"
msgid "Matching models"
msgstr "Modèles correspondants"

#. OMI translation key: /researchModules/transkribus/copy/modelCenturies
msgctxt "/researchModules/transkribus/copy/modelCenturies"
msgid "Centuries"
msgstr "Siècles"

#. OMI translation key: /researchModules/transkribus/copy/errors/TRANSKRIBUS_MODELS_UNAVAILABLE
msgctxt "/researchModules/transkribus/copy/errors/TRANSKRIBUS_MODELS_UNAVAILABLE"
msgid "The public model catalogue could not be loaded. Try again or enter a model ID manually."
msgstr "Impossible de charger le catalogue public des modèles. Réessayez ou saisissez un identifiant de modèle manuellement."

#. OMI translation key: /uncataloguedUi/euroOfficeRecovery/title
msgctxt "/uncataloguedUi/euroOfficeRecovery/title"
msgid "Recovery saves"
msgstr "Récupérations enregistrées"

#. OMI translation key: /uncataloguedUi/euroOfficeRecovery/description
msgctxt "/uncataloguedUi/euroOfficeRecovery/description"
msgid "Force saves and conflicting callbacks are retained here. Final content is committed when the editor closes. Download a snapshot to recover it; this does not replace the current document."
msgstr "Les enregistrements forcés et les réponses conflictuelles sont conservés ici. Le contenu final est validé à la fermeture de l’éditeur. Téléchargez un instantané pour le récupérer ; cela ne remplace pas le document actuel."

#. OMI translation key: /uncataloguedUi/euroOfficeRecovery/loading
msgctxt "/uncataloguedUi/euroOfficeRecovery/loading"
msgid "Loading…"
msgstr "Chargement…"

#. OMI translation key: /uncataloguedUi/euroOfficeRecovery/empty
msgctxt "/uncataloguedUi/euroOfficeRecovery/empty"
msgid "No saved snapshots."
msgstr "Aucun instantané enregistré."

#. OMI translation key: /uncataloguedUi/euroOfficeRecovery/final
msgctxt "/uncataloguedUi/euroOfficeRecovery/final"
msgid "Final save"
msgstr "Enregistrement final"

#. OMI translation key: /uncataloguedUi/euroOfficeRecovery/previous
msgctxt "/uncataloguedUi/euroOfficeRecovery/previous"
msgid "Previous document"
msgstr "Document précédent"

#. OMI translation key: /uncataloguedUi/euroOfficeRecovery/recovery
msgctxt "/uncataloguedUi/euroOfficeRecovery/recovery"
msgid "Recovery snapshot"
msgstr "Instantané de récupération"

#. OMI translation key: /uncataloguedUi/euroOfficeRecovery/failed
msgctxt "/uncataloguedUi/euroOfficeRecovery/failed"
msgid "Recovery saves could not be loaded or downloaded."
msgstr "Impossible de charger ou de télécharger les enregistrements de récupération."

#. OMI translation key: /researchModules/history-archives-siusa-search-panel/copyByLocale/title
msgctxt "/researchModules/history-archives-siusa-search-panel/copyByLocale/title"
msgid "SIUSA — Italian archival descriptions"
msgstr "SIUSA – archives italiennes"

#. OMI translation key: /researchModules/history-archives-siusa-search-panel/copyByLocale/description
msgctxt "/researchModules/history-archives-siusa-search-panel/copyByLocale/description"
msgid "Search SIUSA, the Italian national information system for non-state archives. Results open in the official catalogue in a new tab."
msgstr "Recherchez dans SIUSA, le système national italien d’information sur les archives non étatiques. Les résultats s’ouvrent dans le catalogue officiel dans un nouvel onglet."

#. OMI translation key: /researchModules/history-archives-siusa-search-panel/copyByLocale/label
msgctxt "/researchModules/history-archives-siusa-search-panel/copyByLocale/label"
msgid "Search SIUSA archives"
msgstr "Rechercher dans SIUSA"

#. OMI translation key: /researchModules/history-archives-siusa-search-panel/copyByLocale/placeholder
msgctxt "/researchModules/history-archives-siusa-search-panel/copyByLocale/placeholder"
msgid "Name, archive, place, or keyword"
msgstr "Nom, archive, lieu ou mot-clé"

#. OMI translation key: /researchModules/history-archives-siusa-search-panel/copyByLocale/search
msgctxt "/researchModules/history-archives-siusa-search-panel/copyByLocale/search"
msgid "Search SIUSA"
msgstr "Rechercher dans SIUSA"

msgctxt "/translationModel/title"
msgid "Translations"
msgstr "Traductions"

msgctxt "/translationModel/description"
msgid "Create and review aligned language variants. Source edits flag affected translations for review; target text remains editable. Variants are saved inside the OMI manuscript."
msgstr "Créez et révisez des versions linguistiques alignées. Les modifications de la source signalent les traductions à vérifier ; le texte cible reste modifiable. Les versions sont enregistrées dans le manuscrit OMI."

msgctxt "/translationModel/targetLanguage"
msgid "Target language (BCP 47)"
msgstr "Langue cible (BCP 47)"

msgctxt "/translationModel/scope"
msgid "Scope"
msgstr "Portée"

msgctxt "/translationModel/manuscript"
msgid "Whole manuscript"
msgstr "Manuscrit entier"

msgctxt "/translationModel/section"
msgid "Selected section"
msgstr "Section sélectionnée"

msgctxt "/translationModel/block"
msgid "Block"
msgstr "Bloc"

msgctxt "/translationModel/create"
msgid "Create translation"
msgstr "Créer une traduction"

msgctxt "/translationModel/empty"
msgid "No language variants yet."
msgstr "Aucune version linguistique."

msgctxt "/translationModel/variant"
msgid "Language variant"
msgstr "Version linguistique"

msgctxt "/translationModel/reviewed"
msgid "Reviewed"
msgstr "Révisé"

msgctxt "/translationModel/draft"
msgid "Draft"
msgstr "Brouillon"

msgctxt "/translationModel/stale"
msgid "Source changed"
msgstr "Source modifiée"

msgctxt "/translationModel/current"
msgid "Current source"
msgstr "Source actuelle"

msgctxt "/translationModel/missing"
msgid "Source missing"
msgstr "Source manquante"

msgctxt "/translationModel/added"
msgid "New source segments"
msgstr "Nouveaux segments source"

msgctxt "/translationModel/synchronize"
msgid "Update source alignment"
msgstr "Actualiser les alignements"

msgctxt "/translationModel/syncHint"
msgid "Updating the alignment keeps target text and translator notes. Changed segments return to draft. Missing source segments remain available until you archive them."
msgstr "L’actualisation conserve le texte cible et les notes. Les segments modifiés redeviennent des brouillons. Les segments source manquants restent disponibles jusqu’à leur archivage."

msgctxt "/translationModel/parallelExport"
msgid "Parallel text HTML"
msgstr "Texte parallèle HTML"

msgctxt "/translationModel/targetExport"
msgid "Target text HTML"
msgstr "Texte cible HTML"

msgctxt "/translationModel/remove"
msgid "Remove variant"
msgstr "Supprimer la version"

msgctxt "/translationModel/removeConfirm"
msgid "Remove this language variant? It remains available in revision history."
msgstr "Supprimer cette version linguistique ? Elle reste disponible dans l’historique."

msgctxt "/translationModel/sourceText"
msgid "Source text"
msgstr "Texte source"

msgctxt "/translationModel/targetText"
msgid "Target text"
msgstr "Texte cible"

msgctxt "/translationModel/notes"
msgid "Translator notes"
msgstr "Notes de traduction"

